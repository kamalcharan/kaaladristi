  "formula": "def is_combust(sun_long, planet_long, planet_name):\n    \"\"\"Check if planet is combust (too close to Sun).\"\"\"\n    diff = abs(sun_long - planet_long)\n    if diff > 180:\n        diff = 360 - diff\n    \n    combustion_degrees = {\n        'Moon': 12,\n        'Mars': 17,\n        'Mercury': 14,\n        'Jupiter': 11,\n        'Venus': 10,\n        'Saturn': 15,\n    }\n    \n    threshold = combustion_degrees.get(planet_name, 0)\n    return diff <= threshold",
