float dist_dn_g = _g_idx_sup != -1 ? radar_view.dist_floor : (use_zone_sup_g ? terrain_status.dist_supp : na)

// 4) Decide ACTIVE SIDE (match the “direction intent”)
// Bull -> RES, Bear -> SUPP, Neutral -> closest existing side
int act_side =
     is_bull_eff ?  1 :
     is_bear_eff ? -1 :
     (not na(dist_up_g) and not na(dist_dn_g) ? (dist_up_g < dist_dn_g ? 1 : -1) :
      not na(dist_up_g) ? 1 :
      not na(dist_dn_g) ? -1 : 0)

// 5) Decide ACTIVE KIND on that side (MA if exists, else Zone, else NONE)
int act_kind = 0          // 0=NONE, 1=MA, 2=ZN
int act_ma_idx = -1
int act_zn_i   = -1

if act_side == 1
    if _g_idx_res != -1
        act_kind  := 1
        act_ma_idx:= _g_idx_res
    else if use_zone_res_g
        act_kind  := 2
        act_zn_i  := terrain_status.res_i
else if act_side == -1
    if _g_idx_sup != -1
        act_kind  := 1
        act_ma_idx:= _g_idx_sup
    else if use_zone_sup_g
        act_kind  := 2
        act_zn_i  := terrain_status.supp_i

// 6) Global Flags used by Strategy & Dashboard
bool has_act = act_kind != 0
bool target_is_res = act_side == 1

bool act_has_ma = act_kind == 1
bool act_has_zn = act_kind == 2


// 7) Resolve ACTIVE LEVEL / PERIOD / CONTEXT / RESULT
int _fallback_i = math.min(3, array.size(period_data_array) - 1)

PeriodStats act_p = na
int   act_period  = na
float act_lvl     = na
InteractionResult act_res = na

if has_act
    if act_kind == 1
        act_p      := array.get(period_data_array, act_ma_idx)
        act_period := array.get(_scan_periods, act_ma_idx)
        act_lvl    := array.get(dvwma_val_array, act_ma_idx)
