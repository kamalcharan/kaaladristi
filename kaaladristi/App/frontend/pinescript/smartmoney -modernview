// Logic: Identifies High Volume Nodes and draws precise Lines at High/Low.
// No Boxes, No Fills, No flickering. Optimized for performance and Dashboard compatibility.

// ─── A. VISUALIZATION SETTINGS ───
grp_viz_mod = "Visualization Settings"

