//──────────────────────────────────────────────────────────────────────────────
// 3.5 CORE CALCULATION ENGINE (HELPER FUNCTIONS & TYPES)
//──────────────────────────────────────────────────────────────────────────────

// A. Math Helpers

// Safe division (avoid division by zero)
f_safe_div(_num, _den) => _den == 0 ? na : _num / _den

// Weighted VWMA using custom weights (safe)
f_wvwma(_src, _w, _len) =>
    float den = math.sum(_w, _len)
    float num = math.sum(_src * _w, _len)
    (na(den) or den == 0) ? na : (num / den)

// Dual VWMA with robust fallbacks (prevents NA/NaN)
f_dvwma(_src, _vb, _vs, _len) =>
    float vw_b = f_wvwma(_src, _vb, _len)
    float vw_s = f_wvwma(_src, _vs, _len)

    // total-weight fallback (uses vb+vs)
    float vw_t = f_wvwma(_src, _vb + _vs, _len)

    // last-resort fallback (TradingView built-in VWMA on chart volume)
    float vw_r = ta.vwma(_src, _len)

    float out = na
    if not na(vw_b) and not na(vw_s)
        out := (vw_b + vw_s) / 2
    else if not na(vw_b)
        out := vw_b
    else if not na(vw_s)
        out := vw_s
    else if not na(vw_t)
        out := vw_t
    else
        out := vw_r

    out


// Calculate angle based on changes (Output in Degrees) - NORMALIZED FIX
// Note: Now uses Percentage Change scaled by 10,000 to make angles consistent across Price Scales (BTC vs EURUSD).
// Clamp + Snap helpers (keeps angles always in [-90, +90] and stable at 0.1°)
f_clamp(_x, _lo, _hi) =>
    math.max(_lo, math.min(_hi, _x))

f_snap(_x, _step) =>
    math.round(_x / _step) * _step

// Angle in degrees (normalized slope) - hard-limited to [-90..+90]
f_calc_angle(_src) =>
    float _denom  = nz(_src[1], _src)
    float _change = ta.change(_src)

    // normalized slope (same logic you had)
    float _slope  = _denom != 0 ? (_change / math.abs(_denom)) * 10000.0 : 0.0

    // raw angle
    float _deg    = math.atan(_slope) * 180.0 / math.pi

    // force safe range + stable rounding
    float _safe   = f_clamp(_deg, -90.0, 90.0)
    f_snap(_safe, 0.1)


  
// Calculate Standard Z-Score
// Formula: (Value - Mean) / Standard Deviation
f_calc_zscore(_src, _len) =>
    _mean = ta.sma(_src, _len)
    _std  = ta.stdev(_src, _len)
    _z    = (_src - _mean) / (_std == 0 ? 1 : _std) // Avoid division by zero
    _z

// ══════════════════════════════════════════════════════════════════════════════
// GRANULAR SCORING HELPER FUNCTIONS (v2.0)
// These functions convert raw values to smooth, gradient-based scores.
// ══════════════════════════════════════════════════════════════════════════════

// Clamp value to range [0, max]
f_score_clamp(_val, _max) =>
    math.max(0.0, math.min(_max, _val))

// Linear interpolation score: maps value from [lo, hi] to [0, max_score]
f_score_linear(_val, _lo, _hi, _max_score) =>
    _val <= _lo ? 0.0 : _val >= _hi ? _max_score : ((_val - _lo) / (_hi - _lo)) * _max_score

// Ratio-based score for Volume Power (k_ratio)
// 0.5x=0, 1.0x=5, 2.0x=8, 3.0x+=10
f_score_k_ratio(_ratio) =>
    _ratio <= 0.5 ? 0.0 :
     _ratio <= 1.0 ? f_score_linear(_ratio, 0.5, 1.0, 5.0) :
     _ratio <= 2.0 ? 5.0 + f_score_linear(_ratio, 1.0, 2.0, 3.0) :
     _ratio <= 3.0 ? 8.0 + f_score_linear(_ratio, 2.0, 3.0, 2.0) :
     10.0

// Z-Score based score for Volume Spike
// 0σ=0, 1σ=4, 2σ=6, 3σ+=8
f_score_zscore(_z, _max_score) =>
    _az = math.abs(_z)
    _az <= 0.5 ? 0.0 :
     _az <= 1.0 ? f_score_linear(_az, 0.5, 1.0, _max_score * 0.5) :
     _az <= 2.0 ? (_max_score * 0.5) + f_score_linear(_az, 1.0, 2.0, _max_score * 0.25) :
     _az <= 3.0 ? (_max_score * 0.75) + f_score_linear(_az, 2.0, 3.0, _max_score * 0.25) :
     _max_score

// Break intensity score: ratio of attacker vs defender
// 0.5x=0, 1.0x=5, 1.5x=8, 2.0x+=10
f_score_break_ratio(_ratio) =>
    _ratio <= 0.5 ? 0.0 :
     _ratio <= 1.0 ? f_score_linear(_ratio, 0.5, 1.0, 5.0) :
     _ratio <= 1.5 ? 5.0 + f_score_linear(_ratio, 1.0, 1.5, 3.0) :
     _ratio <= 2.0 ? 8.0 + f_score_linear(_ratio, 1.5, 2.0, 2.0) :
     10.0

// Pressure imbalance score (attacking side %)
// 50%=0, 60%=3, 70%=5, 80%+=7
f_score_pressure(_pct) =>
    _pct <= 50.0 ? 0.0 :
     _pct <= 60.0 ? f_score_linear(_pct, 50.0, 60.0, 3.0) :
     _pct <= 70.0 ? 3.0 + f_score_linear(_pct, 60.0, 70.0, 2.0) :
     _pct <= 80.0 ? 5.0 + f_score_linear(_pct, 70.0, 80.0, 2.0) :
     7.0

// Impact angle score: higher angle = more direct impact
// 0°=1, 45°=4, 90°=7
f_score_impact_angle(_ang) =>
    _ang <= 0.0 ? 1.0 :
     _ang <= 45.0 ? 1.0 + f_score_linear(_ang, 0.0, 45.0, 3.0) :
     _ang <= 90.0 ? 4.0 + f_score_linear(_ang, 45.0, 90.0, 3.0) :
     7.0

// Alignment score: boolean with optional intensity boost
f_score_align(_is_aligned, _intensity, _max_score) =>
    _is_aligned ? math.min(_max_score, _max_score * 0.6 + math.abs(_intensity) * 0.1) : 0.0

// Stack depth score: 0-10 depth maps to 0-5 score
f_score_stack(_depth, _max_depth) =>
    _max_depth <= 0 ? 0.0 : (_depth / _max_depth) * 5.0

// Confluence score: ally percentage maps to 0-5
f_score_confluence(_pct) =>
    _pct <= 0.0 ? 0.0 : _pct >= 100.0 ? 5.0 : (_pct / 100.0) * 5.0

// Trend alignment score: count of 3 possible alignments (VAN/MID/GEN)
f_score_trend_align(_count) =>
    _count <= 0 ? 0.0 : _count == 1 ? 1.5 : _count == 2 ? 3.5 : 5.0

// Grade converter: score to letter grade
f_score_to_grade(_score) =>
    _score >= 90 ? "A+" :
     _score >= 80 ? "A"  :
     _score >= 70 ? "B+" :
     _score >= 60 ? "B"  :
     _score >= 50 ? "C+" :
     _score >= 40 ? "C"  :
     _score >= 30 ? "D"  :
     "F"

