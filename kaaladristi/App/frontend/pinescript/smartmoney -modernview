        int _zi = act_zn_i != -1 ? act_zn_i : _fallback_i
        act_p      := array.get(period_data_array, _zi)
        act_period := array.get(_scan_periods, _zi)
        act_lvl    := target_is_res ? terrain_status.res_lvl : terrain_status.supp_lvl
        act_res    := f_interrogate_zone_layer1(trader_self, act_p, target_is_res)
        
        // Inject Layer 5 scores for Zone-based result
        if not na(act_res)
            act_res.a_stack_score      := _l5_stack
            act_res.a_confluence_score := _l5_confluence
            act_res.a_trend_score      := _l5_trend
            act_res.layer5_score       := _l5_total
            act_res.total_score        := act_res.layer1_score + act_res.layer2_score + act_res.layer3_score + act_res.layer4_score + _l5_total
            act_res.grade              := f_score_to_grade(act_res.total_score)

// ──────────────────────────────────────────────────────────────────────────────
