// ==============================================================================
// SIGNAL DETECTION ENGINE (State Machine v2.0)
// With Timer + Range Validation + Smart Reset Logic
// ==============================================================================

// ──────────────────────────────────────────────────────────────────────────────
// CONSTANTS & HELPERS
// ──────────────────────────────────────────────────────────────────────────────
float SCORE_MIN = signal_score_min_in
float SCORE_MAX = signal_score_max_in
float LOCK_RANGE_PCT = lock_range_pct_in / 100.0

int STATE_FLAT   = 0
int STATE_BUYER  = 1
int STATE_SELLER = -1

// Validation status
int VAL_NONE      = 0
int VAL_PENDING   = 1
int VAL_CONFIRMED = 2
int VAL_RESET     = 3

f_getLabelSize(_s) => 
    _s == "Tiny" ? size.tiny : _s == "Small" ? size.small : _s == "Normal" ? size.normal : size.large

label_sz = f_getLabelSize(label_size_in)

// Display mode flags
bool is_minimal  = display_mode_in == "Minimal"
bool is_normal   = display_mode_in == "Normal"
bool is_detailed = display_mode_in == "Detailed"

// ──────────────────────────────────────────────────────────────────────────────
// SCORE CALCULATION
// ──────────────────────────────────────────────────────────────────────────────
float current_score = is_testing_level and not na(act_res) ? act_res.total_score : 0.0
bool score_in_range = not na(current_score) and (current_score >= SCORE_MIN) and (current_score <= SCORE_MAX)

// ──────────────────────────────────────────────────────────────────────────────
// RAW SIGNAL DETECTION (Before Validation)
// ──────────────────────────────────────────────────────────────────────────────
int raw_signal = STATE_FLAT

if (eff_dir == 1) and testing_supply and score_in_range
    raw_signal := STATE_BUYER
else if (eff_dir == -1) and testing_demand and score_in_range
    raw_signal := STATE_SELLER

// ──────────────────────────────────────────────────────────────────────────────
// STATE MACHINE WITH VALIDATION
// ──────────────────────────────────────────────────────────────────────────────

// Persistent state variables
var int   confirmed_state   = STATE_FLAT
var int   pending_state     = STATE_FLAT
var int   validation_status = VAL_NONE

// Lock tracking
var float lock_price        = na
var float lock_score        = na
var int   lock_bar          = na
var int   lock_time         = na

// Previous lock (for strength comparison)
var float prev_lock_price   = na
var float prev_lock_score   = na

// Validation counters
var int   validation_ticks  = 0

// Range boundaries (calculated from lock)
var float range_upper       = na
var float range_lower       = na

// ──────────────────────────────────────────────────────────────────────────────
// RANGE & TIME CALCULATIONS
// ──────────────────────────────────────────────────────────────────────────────
// Calculate time elapsed (real-time only, fallback to ticks for historical)
int time_elapsed_ms = not na(lock_time) ? (timenow - lock_time) : 0
int time_elapsed_sec = time_elapsed_ms / 1000

// Check if enough time/ticks passed
bool ticks_ok = validation_ticks >= validation_ticks_in
bool time_ok = barstate.isrealtime ? (time_elapsed_sec >= validation_seconds_in) : true
bool validation_time_passed = ticks_ok and time_ok

// Price position relative to lock range
string price_vs_range = "IN_RANGE"
if not na(lock_price) and not na(range_upper) and not na(range_lower)
    if close > range_upper
        price_vs_range := "ABOVE"
    else if close < range_lower
        price_vs_range := "BELOW"

// ──────────────────────────────────────────────────────────────────────────────
// TRANSITION FLAGS
// ──────────────────────────────────────────────────────────────────────────────
bool is_new_buyer       = false
bool is_new_seller      = false
bool is_buyer_to_seller = false
bool is_seller_to_buyer = false
bool is_buyer_end       = false
bool is_seller_end      = false
bool is_buyer_stronger  = false
bool is_seller_stronger = false
bool is_reset           = false

float strength_vs_prev  = na
string strength_txt     = ""

// ──────────────────────────────────────────────────────────────────────────────
// MAIN STATE MACHINE LOGIC
// ──────────────────────────────────────────────────────────────────────────────

// Get previous confirmed state
int prev_confirmed = nz(confirmed_state[1], STATE_FLAT)

// ═══════════════════════════════════════════════════════════════════════════
// CASE 1: Currently FLAT - Looking for new signal
// ═══════════════════════════════════════════════════════════════════════════
if confirmed_state == STATE_FLAT

    if raw_signal == STATE_BUYER
        // Start validation for BUYER
        if validation_status == VAL_NONE or pending_state != STATE_BUYER
            // First detection - initialize
            pending_state := STATE_BUYER
            validation_status := VAL_PENDING
            lock_price := close
            lock_score := current_score
            lock_bar := bar_index
            lock_time := timenow
            range_upper := lock_price * (1.0 + LOCK_RANGE_PCT)
            range_lower := lock_price * (1.0 - LOCK_RANGE_PCT)
            validation_ticks := 1
        else
            // Continuing validation
            // Check if price went against us (below range)
            if price_vs_range == "BELOW"
                // RESET - price went wrong direction
                is_reset := true
                validation_status := VAL_NONE
                pending_state := STATE_FLAT
                validation_ticks := 0
            else
                // Price OK (in range or above)
                validation_ticks += 1
                
                // Update lock if price went higher (stronger)
                if price_vs_range == "ABOVE"
                    lock_price := close
                    lock_score := current_score
                    range_upper := lock_price * (1.0 + LOCK_RANGE_PCT)
                    range_lower := lock_price * (1.0 - LOCK_RANGE_PCT)
                
                // Check if validation complete
                if validation_time_passed
                    // CONFIRMED BUYER
                    is_new_buyer := true
                    confirmed_state := STATE_BUYER
                    validation_status := VAL_CONFIRMED
                    
                    // Calculate strength vs previous
                    if not na(prev_lock_price) and prev_lock_price != 0
                        strength_vs_prev := ((lock_price - prev_lock_price) / prev_lock_price) * 100.0
                        strength_txt := strength_vs_prev > 0.1 ? "STRONGER ▲" : strength_vs_prev < -0.1 ? "WEAKER ▼" : "SAME ●"

    else if raw_signal == STATE_SELLER
        // Start validation for SELLER
        if validation_status == VAL_NONE or pending_state != STATE_SELLER
            // First detection - initialize
            pending_state := STATE_SELLER
            validation_status := VAL_PENDING
            lock_price := close
            lock_score := current_score
            lock_bar := bar_index
            lock_time := timenow
            range_upper := lock_price * (1.0 + LOCK_RANGE_PCT)
            range_lower := lock_price * (1.0 - LOCK_RANGE_PCT)
            validation_ticks := 1
        else
            // Continuing validation
            // Check if price went against us (above range)
            if price_vs_range == "ABOVE"
                // RESET - price went wrong direction
                is_reset := true
                validation_status := VAL_NONE
                pending_state := STATE_FLAT
                validation_ticks := 0
            else
                // Price OK (in range or below)
                validation_ticks += 1
                
                // Update lock if price went lower (stronger)
                if price_vs_range == "BELOW"
                    lock_price := close
                    lock_score := current_score
                    range_upper := lock_price * (1.0 + LOCK_RANGE_PCT)
                    range_lower := lock_price * (1.0 - LOCK_RANGE_PCT)
                
                // Check if validation complete
                if validation_time_passed
                    // CONFIRMED SELLER
                    is_new_seller := true
                    confirmed_state := STATE_SELLER
                    validation_status := VAL_CONFIRMED
                    
                    // Calculate strength vs previous
                    if not na(prev_lock_price) and prev_lock_price != 0
                        strength_vs_prev := ((lock_price - prev_lock_price) / prev_lock_price) * 100.0
                        strength_txt := strength_vs_prev < -0.1 ? "STRONGER ▼" : strength_vs_prev > 0.1 ? "WEAKER ▲" : "SAME ●"

    else
        // No signal - reset pending
        if validation_status == VAL_PENDING
            validation_status := VAL_NONE
            pending_state := STATE_FLAT
            validation_ticks := 0

// ═══════════════════════════════════════════════════════════════════════════
// CASE 2: Currently BUYER - Monitoring for continuation/exit/reversal
// ═══════════════════════════════════════════════════════════════════════════
else if confirmed_state == STATE_BUYER

    if raw_signal == STATE_BUYER
        // Still BUYER signal
        validation_ticks += 1
        
        // Check if stronger (price above range)
        if price_vs_range == "ABOVE"
            is_buyer_stronger := true
            prev_lock_price := lock_price
            prev_lock_score := lock_score
            lock_price := close
            lock_score := current_score
            lock_bar := bar_index
            range_upper := lock_price * (1.0 + LOCK_RANGE_PCT)
            range_lower := lock_price * (1.0 - LOCK_RANGE_PCT)
            
        // Check for RESET (price below range while still "buyer" signal)
        else if price_vs_range == "BELOW"
            // Price dropped significantly - reset to re-evaluate
            is_reset := true
            confirmed_state := STATE_FLAT
            validation_status := VAL_NONE
            pending_state := STATE_FLAT
            validation_ticks := 0
            
    else if raw_signal == STATE_SELLER
        // Potential REVERSAL - start validation
        if validation_status != VAL_PENDING or pending_state != STATE_SELLER
            pending_state := STATE_SELLER
            validation_status := VAL_PENDING
            prev_lock_price := lock_price
            prev_lock_score := lock_score
            lock_price := close
            lock_score := current_score
            lock_bar := bar_index
            lock_time := timenow
            range_upper := lock_price * (1.0 + LOCK_RANGE_PCT)
            range_lower := lock_price * (1.0 - LOCK_RANGE_PCT)
            validation_ticks := 1
        else
            // Check reversal validation
            if price_vs_range == "ABOVE"
                // Failed reversal - back to BUYER
                validation_status := VAL_CONFIRMED
                pending_state := STATE_FLAT
                validation_ticks := 0
            else
                validation_ticks += 1
                if price_vs_range == "BELOW"
                    lock_price := close
                    lock_score := current_score
                    range_upper := lock_price * (1.0 + LOCK_RANGE_PCT)
                    range_lower := lock_price * (1.0 - LOCK_RANGE_PCT)
                
                if validation_time_passed
                    // CONFIRMED REVERSAL
                    is_buyer_to_seller := true
                    confirmed_state := STATE_SELLER
                    validation_status := VAL_CONFIRMED
                    strength_vs_prev := ((lock_price - prev_lock_price) / prev_lock_price) * 100.0
        
    else
        // Signal conditions lost - check exit rules
        int bars_since_confirm = bar_index - lock_bar
        bool hold_period_passed = bars_since_confirm >= hold_bars_min_in
        
        // Calculate stop loss level
        float stop_level = lock_price * (1.0 - stop_loss_pct_in / 100.0)
        bool stop_hit = close < stop_level
        
        // Determine if we should exit
        bool should_exit = false
        
        if exit_mode_in == "Signal Loss"
            // Original behavior - exit when signal disappears
            should_exit := hold_period_passed
        else if exit_mode_in == "Price Stop"
            // Exit only on stop loss
            should_exit := stop_hit
        else
            // "Reversal Only" - don't exit here, wait for reversal
            should_exit := false
        
        if should_exit
            is_buyer_end := true
            prev_lock_price := lock_price
            prev_lock_score := lock_score
            confirmed_state := STATE_FLAT
            validation_status := VAL_NONE
            pending_state := STATE_FLAT
            validation_ticks := 0
        // else: Stay in BUYER state, don't show FLAT

// ═══════════════════════════════════════════════════════════════════════════
// CASE 3: Currently SELLER - Monitoring for continuation/exit/reversal
// ═══════════════════════════════════════════════════════════════════════════
else if confirmed_state == STATE_SELLER

    if raw_signal == STATE_SELLER
        // Still SELLER signal
        validation_ticks += 1
        
        // Check if stronger (price below range)
        if price_vs_range == "BELOW"
            is_seller_stronger := true
            prev_lock_price := lock_price
            prev_lock_score := lock_score
            lock_price := close
            lock_score := current_score
            lock_bar := bar_index
            range_upper := lock_price * (1.0 + LOCK_RANGE_PCT)
            range_lower := lock_price * (1.0 - LOCK_RANGE_PCT)
            
        // Check for RESET (price above range while still "seller" signal)
        else if price_vs_range == "ABOVE"
            // Price rose significantly - reset to re-evaluate
            is_reset := true
            confirmed_state := STATE_FLAT
            validation_status := VAL_NONE
            pending_state := STATE_FLAT
            validation_ticks := 0
            
    else if raw_signal == STATE_BUYER
        // Potential REVERSAL - start validation
        if validation_status != VAL_PENDING or pending_state != STATE_BUYER
            pending_state := STATE_BUYER
            validation_status := VAL_PENDING
            prev_lock_price := lock_price
            prev_lock_score := lock_score
            lock_price := close
            lock_score := current_score
            lock_bar := bar_index
            lock_time := timenow
            range_upper := lock_price * (1.0 + LOCK_RANGE_PCT)
            range_lower := lock_price * (1.0 - LOCK_RANGE_PCT)
            validation_ticks := 1
        else
            // Check reversal validation
            if price_vs_range == "BELOW"
                // Failed reversal - back to SELLER
                validation_status := VAL_CONFIRMED
                pending_state := STATE_FLAT
                validation_ticks := 0
            else
                validation_ticks += 1
                if price_vs_range == "ABOVE"
                    lock_price := close
                    lock_score := current_score
                    range_upper := lock_price * (1.0 + LOCK_RANGE_PCT)
                    range_lower := lock_price * (1.0 - LOCK_RANGE_PCT)
                
                if validation_time_passed
                    // CONFIRMED REVERSAL
                    is_seller_to_buyer := true
                    confirmed_state := STATE_BUYER
                    validation_status := VAL_CONFIRMED
                    strength_vs_prev := ((lock_price - prev_lock_price) / prev_lock_price) * 100.0
        
    else
        // Signal conditions lost - check exit rules
        int bars_since_confirm = bar_index - lock_bar
        bool hold_period_passed = bars_since_confirm >= hold_bars_min_in
        
        // Calculate stop loss level
        float stop_level = lock_price * (1.0 + stop_loss_pct_in / 100.0)
        bool stop_hit = close > stop_level
        
        // Determine if we should exit
        bool should_exit = false
        
        if exit_mode_in == "Signal Loss"
            should_exit := hold_period_passed
        else if exit_mode_in == "Price Stop"
            should_exit := stop_hit
        else
            // "Reversal Only"
            should_exit := false
        
        if should_exit
            is_seller_end := true
            prev_lock_price := lock_price
            prev_lock_score := lock_score
            confirmed_state := STATE_FLAT
            validation_status := VAL_NONE
            pending_state := STATE_FLAT
            validation_ticks := 0

