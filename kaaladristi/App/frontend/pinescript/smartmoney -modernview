// ─── B. GLOBAL VARIABLES (CRITICAL FOR DASHBOARD) ───
// These variables are required by Section 6. Do not remove.
var int  viz_lastValidShift = na
var bool viz_usingLastValid = false

// Calculate shift globally to maintain series consistency (Fixes 'ta.barssince' warning)
int shiftRaw = (volModel == "Intrabar (Precise)") ? ta.barssince(volOk) : 0
int MAX_BACK = 500

// Update global state variables on every bar (so Dashboard can read them)
viz_lastValidShift := (na(shiftRaw) or shiftRaw > MAX_BACK) ? na : shiftRaw
viz_usingLastValid := (volModel == "Intrabar (Precise)") and not na(viz_lastValidShift) and (viz_lastValidShift > 0)

// ─── C. DRAWING ENGINE (LINES ONLY) ───
var line[] viz_lines = array.new_line()

// Helper to draw a level pair
f_draw_level(_x1, _y, _x2, _col, _is_main) =>
    // Main line is solid, secondary (bottom) is slightly transparent or different style if needed
    _style = line.style_solid
    _width = _is_main ? 1 : 1 
    _color = _is_main ? _col : color.new(_col, 50)
    line.new(_x1, _y, _x2, _y, xloc=xloc.bar_index, color=_color, style=_style, width=_width)

if barstate.islast
    // 1. Garbage Collection (Clear old lines to prevent flickering/ghosting)
    int _sz = array.size(viz_lines)
    if _sz > 0
        for i = 0 to _sz - 1
            line.delete(array.get(viz_lines, i))
    array.clear(viz_lines)

    // 2. Logic Execution
    // Only run expensive loops if visualization is enabled and data is valid
    if show_viz and not na(viz_lastValidShift)
        // Define scan periods based on mode
        int[] periods = modeSelect == "Micro" ? array.from(7, 13, 19, 23, 31, 41, 47) : array.from(7, 13, 19, 23, 31, 41, 47, 67, 83, 97)
        int n_p = array.size(periods)
        
        int shift = viz_lastValidShift
        int bars_avail = MAX_BACK - shift
        
        // Arrays to store Buy Levels for collision detection
        var float[] drawn_buy_levels = array.new_float()
        array.clear(drawn_buy_levels)

        // Loop through each period to find the HVN (High Volume Node)
        for i = 0 to n_p - 1
            int P = array.get(periods, i)
            
            // Mode Logic
            int Pscan = (calc_mode == "Best Effort") ? math.min(P, bars_avail) : P
            bool h_ok = (calc_mode == "Best Effort") ? (Pscan > 0) : (bars_avail >= P)
            
            // Streak Logic
            int streakEff = na(_ibStreak[shift]) ? 0 : _ibStreak[shift]
            bool s_ok = (volModel != "Intrabar (Precise)") ? true : (calc_mode == "Best Effort" ? true : (not strict_strk ? true : streakEff >= P))

            if h_ok and s_ok
                // 1. Find Max Buy Vol
                float max_vb = -1.0
                int   idx_vb = -1
                // 2. Find Max Sell Vol
                float max_vs = -1.0
                int   idx_vs = -1
                
                // Scan the history
                for k = 0 to Pscan - 1
                    int loc = shift + k
                    if loc < 500 // Safety
                        float _vb = volB[loc]
                        float _vs = volS[loc]
                        
                        if not na(_vb) and _vb > max_vb
                            max_vb := _vb
                            idx_vb := loc
                        
                        if not na(_vs) and _vs > max_vs
                            max_vs := _vs
                            idx_vs := loc
                
                // DRAW BUY LEVELS (Blue Lines) & Store Coordinates
                if idx_vb != -1
                    int abs_idx_b = bar_index - idx_vb
                    float h_b = high[idx_vb]
                    float l_b = low[idx_vb]
                    
                    // Top Line
                    array.push(viz_lines, f_draw_level(abs_idx_b, h_b, bar_index + off_val, c_buy_ln, true))
                    array.push(drawn_buy_levels, h_b) // Store for collision check
                    // Bottom Line
                    array.push(viz_lines, f_draw_level(abs_idx_b, l_b, bar_index + off_val, c_buy_ln, false))
                    array.push(drawn_buy_levels, l_b) // Store for collision check
                    
                // DRAW SELL LEVELS (Red Lines) with COLLISION CHECK
                if idx_vs != -1
                    int abs_idx_s = bar_index - idx_vs
                    float h_s = high[idx_vs]
                    float l_s = low[idx_vs]
                    
                    // Check Collision for High
                    bool col_h = false
                    if array.size(drawn_buy_levels) > 0
                        for db = 0 to array.size(drawn_buy_levels) - 1
                            if math.abs(h_s - array.get(drawn_buy_levels, db)) < syminfo.mintick * 2
                                col_h := true
                    
                    // Draw High (Yellow if collision, Red if not)
                    line l_h = f_draw_level(abs_idx_s, h_s, bar_index + off_val, col_h ? color.yellow : c_sell_ln, true)
                    if col_h
                        line.set_width(l_h, 2) // Make yellow line thicker
                    array.push(viz_lines, l_h)

                    // Check Collision for Low
                    bool col_l = false
                    if array.size(drawn_buy_levels) > 0
                        for db = 0 to array.size(drawn_buy_levels) - 1
                            if math.abs(l_s - array.get(drawn_buy_levels, db)) < syminfo.mintick * 2
                                col_l := true

                    // Draw Low (Yellow if collision, Red if not)
                    line l_l = f_draw_level(abs_idx_s, l_s, bar_index + off_val, col_l ? color.yellow : c_sell_ln, false)
                    if col_l
                        line.set_width(l_l, 2) // Make yellow line thicker
                    array.push(viz_lines, l_l) 


