// F. The "Hierarchy Engine" (Layer 2 Analysis)
// Evaluates the Matrix Formation behind the Trader.
f_check_hierarchy(_t, _p_arr, _eff_dir) =>
    // _t: TraderEntity (Now)
    // _p_arr: Full Array of PeriodStats (The Matrix History)
    // _eff_dir: Effective direction with hysteresis (eff_dir)

    // A. Identify Intent (Direction based on eff_dir - hysteresis)
    int _dir = _eff_dir
    bool _is_short = _dir == -1
    bool _is_long  = _dir == 1


    // B. Check Alliances (Iterate through all lines)
    int _allies = 0
    int _total_lines = array.size(_p_arr)
    
    for i = 0 to _total_lines - 1
        PeriodStats _p = array.get(_p_arr, i)
        bool _is_ally = false
        
        if _is_short
            // To be a Bearish Ally: Must be ABOVE price AND Angling DOWN
            if _p.p_dvwma > _t.price_now and _p.p_angle < 0
                _is_ally := true
        else if _is_long
            // To be a Bullish Ally: Must be BELOW price AND Angling UP
            if _p.p_dvwma < _t.price_now and _p.p_angle > 0
                _is_ally := true
        
        if _is_ally
            _allies += 1

    float _ally_pow = (_allies / _total_lines) * 100.0

    // C. Check Mastery (Key Battles)
    // Index Mapping: 0=7, 1=13, 2=19, 3=23 ... 9=97
    // We need at least index 3 (Period 23) to check basics.
    bool _v_win = false // 7 vs 13
    bool _m_win = false // 13 vs 23
    bool _g_win = false // 23 vs 97 (Macro)

    if _total_lines >= 2
        PeriodStats p7  = array.get(_p_arr, 0)
        PeriodStats p13 = array.get(_p_arr, 1)
        if _is_short
            _v_win := p7.p_dvwma < p13.p_dvwma
        else if _is_long
            _v_win := p7.p_dvwma > p13.p_dvwma
            
    if _total_lines >= 4 // Need index 3 (23)
        PeriodStats p13 = array.get(_p_arr, 1)
        PeriodStats p23 = array.get(_p_arr, 3)
        if _is_short
            _m_win := p13.p_dvwma < p23.p_dvwma
        else if _is_long
            _m_win := p13.p_dvwma > p23.p_dvwma

    if _total_lines >= 10 // Need index 9 (97)
        PeriodStats p23 = array.get(_p_arr, 3)
        PeriodStats p97 = array.get(_p_arr, 9)
        if _is_short
            _g_win := p23.p_dvwma < p97.p_dvwma
        else if _is_long
            _g_win := p23.p_dvwma > p97.p_dvwma

    // D. Check Perfect Stack (The Formation)
    // Are lines ordered 0 < 1 < 2 < 3 ... ?
    int _depth = 0
    bool _stack_broken = false
    if _total_lines > 1
        for i = 0 to _total_lines - 2
            if _stack_broken
                break
            
            PeriodStats p_curr = array.get(_p_arr, i)
            PeriodStats p_next = array.get(_p_arr, i+1)
            
            bool _order_ok = false
            if _is_short
                _order_ok := p_curr.p_dvwma < p_next.p_dvwma
            else if _is_long
                _order_ok := p_curr.p_dvwma > p_next.p_dvwma
            
            if _order_ok
                _depth += 1
            else
                _stack_broken := true

    bool _perf_stack = _depth == (_total_lines - 1)

    HierarchyStatus.new(_perf_stack, _depth, _v_win, _m_win, _g_win, _allies, _ally_pow)

// G. The "Zone Scanner" (Layer 3 Analysis)
// Lo// Helper: period -> index (0..9)
f_p2i(_p) =>
    _p == 7  ? 0 : 
     _p == 13 ? 1 : 
     _p == 19 ? 2 : 
     _p == 23 ? 3 : 
     _p == 31 ? 4 : 
     _p == 41 ? 5 : 
     _p == 47 ? 6 : 
     _p == 67 ? 7 : 
     _p == 83 ? 8 : 
     _p == 97 ? 9 : -1

// G. The "Zone Scanner" (Layer 3 Analysis)
// Locates the nearest Money Memory Nodes (High Volume Zones) relative to Trader.
// NOTE: ta.highestbars() is precomputed OUTSIDE loops to avoid warnings.
f_scan_zones(_t, _vb, _vs, _p_arr_int, _hb_buy_arr, _hb_sell_arr) =>

    // selected zone details (final)
    float _z_top  = na
    float _z_bot  = na
    float _z_vb   = na
    float _z_vs   = na
    int   _z_kind = na
    int   _z_age  = na
    int   _z_i    = -1

    float _min_dist_res = 1000000.0
    bool  _found_res    = false
    float _s_res        = 0.0
    float _res_lvl      = na
    int   _res_i        = -1

    float _min_dist_sup = 1000000.0
    bool  _found_sup    = false
    float _s_sup        = 0.0
    float _sup_lvl      = na
    int   _sup_i        = -1

    bool  _in_zone      = false
    float _in_vol       = 0.0
    float _in_d_res     = na
    float _in_d_sup     = na
    float _in_top       = na
    float _in_bot       = na
    int   _in_i         = -1

    // NEW: store selected candle details for dashboard
    // NEW: store selected candle details for dashboard
    float _res_top = na
    float _res_bot = na
    float _res_vb  = na
    float _res_vs  = na

    int _res_kind = na
    int _res_age  = na

    float _sup_top = na
    float _sup_bot = na
    float _sup_vb  = na
    float _sup_vs  = na

    int _sup_kind = na
    int _sup_age  = na

    float _in_vb = na
    float _in_vs = na

    int _in_kind = na
    int _in_age  = na



    int _p_count = array.size(_p_arr_int)

    for i = 0 to _p_count - 1
        int _p  = array.get(_p_arr_int, i)
        int _pi = f_p2i(_p)

        // 1) Max Buy Volume (PRECOMPUTED)
        int _hb_idx = (_pi == -1) ? na : array.get(_hb_buy_arr, _pi)
        if not na(_hb_idx)
            int _idx_abs = math.abs(_hb_idx)
            float _top = high[_idx_abs]
            float _bot = low[_idx_abs]
            float _vol = _vb[_idx_abs]
            float _vb_c = _vb[_idx_abs]
            float _vs_c = _vs[_idx_abs]

            float _node = _vb_c + _vs_c   // TOTAL node volume (Buy+Sell)


            int _hs_same = (_pi == -1) ? na : array.get(_hb_sell_arr, _pi)
            bool _both = not na(_hs_same) and math.abs(_hs_same) == _idx_abs
            int _kind = _both ? 0 : 1          // 0=BOTH, 1=BUY EXT
            int _age  = _idx_abs               // bars ago

            if _t.price_now < _bot
                float _d = _bot - _t.price_now
                if _d < _min_dist_res
                    _min_dist_res := _d
                    _found_res    := true
                    _s_res        :=_node
                    _res_lvl      := _bot     // resistance boundary = bottom (nearest edge)
                    _res_i        := _pi
                    _res_top  := _top
                    _res_bot  := _bot
                    _res_vb   := _vb_c
                    _res_vs   := _vs_c
                    _res_kind := _kind
                    _res_age  := _age

            else if _t.price_now > _top
                float _d = _t.price_now - _top
                if _d < _min_dist_sup
                    _min_dist_sup := _d
                    _found_sup    := true
                    _s_sup        :=_node
                    _sup_lvl      := _top     // support boundary = top (nearest edge)
                    _sup_i        := _pi
                    _sup_top  := _top
                    _sup_bot  := _bot
                    _sup_vb   := _vb_c
                    _sup_vs   := _vs_c
                    _sup_kind := _kind
                    _sup_age  := _age

            else
                _in_zone := true
                float _d_top = _top - _t.price_now
                float _d_bot = _t.price_now - _bot

                bool take_inside = na(_in_age) or (_age < _in_age) or (_age == _in_age and _node > _in_vol)

                if take_inside
                    _in_vol   := _node
                    _in_d_res := _d_top
                    _in_d_sup := _d_bot
                    _in_top   := _top
                    _in_bot   := _bot
                    _in_i     := _pi
                    _in_vb    := _vb_c
                    _in_vs    := _vs_c
                    _in_kind  := _kind
                    _in_age   := _age

        // 2) Max Sell Volume (PRECOMPUTED)
        int _hs_idx = (_pi == -1) ? na : array.get(_hb_sell_arr, _pi)
        if not na(_hs_idx)
            int _idx_abs = math.abs(_hs_idx)
            float _top = high[_idx_abs]
            float _bot = low[_idx_abs]
            float _vol = _vs[_idx_abs]
            float _vb_c = _vb[_idx_abs]
            float _vs_c = _vs[_idx_abs]
            float _node = _vb_c + _vs_c   // TOTAL node volume (Buy+Sell)
            int _hb_same = (_pi == -1) ? na : array.get(_hb_buy_arr, _pi)
            bool _both = not na(_hb_same) and math.abs(_hb_same) == _idx_abs
            int _kind = _both ? 0 : -1         // 0=BOTH, -1=SELL EXT
            int _age  = _idx_abs


            if _t.price_now < _bot
                float _d = _bot - _t.price_now
                if _d < _min_dist_res
                    _min_dist_res := _d
                    _found_res    := true
                    _s_res        :=_node
                    _res_lvl      := _bot
                    _res_i        := _pi
                    _res_top  := _top
                    _res_bot  := _bot
                    _res_vb   := _vb_c
                    _res_vs   := _vs_c
                    _res_kind := _kind
                    _res_age  := _age
                    
            else if _t.price_now > _top
                float _d = _t.price_now - _top
                if _d < _min_dist_sup
                    _min_dist_sup := _d
                    _found_sup    := true
                    _s_sup        := _node
                    _sup_lvl      := _top
                    _sup_i        := _pi

                    // NEW: keep full sup candidate details
                    _sup_top  := _top
                    _sup_bot  := _bot
                    _sup_vb   := _vb_c
                    _sup_vs   := _vs_c
                    _sup_kind := _kind
                    _sup_age  := _age

            else
                _in_zone := true
                float _d_top = _top - _t.price_now
                float _d_bot = _t.price_now - _bot

                bool take_inside = na(_in_age) or (_age < _in_age) or (_age == _in_age and _node > _in_vol)

                if take_inside
                    _in_vol   := _node
                    _in_d_res := _d_top
                    _in_d_sup := _d_bot
                    _in_top   := _top
                    _in_bot   := _bot
                    _in_i     := _pi

                    _in_vb   := _vb_c
                    _in_vs   := _vs_c
                    _in_kind := _kind
                    _in_age  := _age

    float _dist_res = _in_zone ? _in_d_res : (_found_res ? _min_dist_res : na)
    float _dist_sup = _in_zone ? _in_d_sup : (_found_sup ? _min_dist_sup : na)
    bool  _has_res  = _in_zone ? true : _found_res
    bool  _has_sup  = _in_zone ? true : _found_sup

    // Final exact levels
    float _final_res_lvl = _in_zone ? _in_top : (_found_res ? _res_lvl : na)
    float _final_sup_lvl = _in_zone ? _in_bot : (_found_sup ? _sup_lvl : na)
    int   _final_res_i   = _in_zone ? _in_i   : (_found_res ? _res_i  : -1)
    int   _final_sup_i   = _in_zone ? _in_i   : (_found_sup ? _sup_i  : -1)

    // Determine which strength to return
    float _final_str = 0.0
    if _in_zone
        _final_str := _in_vol
    else
        if _found_res and _found_sup
            _final_str := (_min_dist_res < _min_dist_sup) ? _s_res : _s_sup
        else
            _final_str := _found_res ? _s_res : (_found_sup ? _s_sup : 0.0)
    
    // ──────────────────────────────────────────────
    // FINAL picked zone payload for dashboard (single zone)
    // Priority: INSIDE > nearest of (RES/SUP)
    // ──────────────────────────────────────────────
    bool _pick_res = (not _in_zone) and _found_res and (not _found_sup or _min_dist_res <= _min_dist_sup)
    bool _pick_sup = (not _in_zone) and _found_sup and (not _found_res or _min_dist_sup <  _min_dist_res)

    if _in_zone
        _z_top  := _in_top
        _z_bot  := _in_bot
        _z_vb   := _in_vb
        _z_vs   := _in_vs
        _z_kind := _in_kind
        _z_age  := _in_age
        _z_i    := _in_i
    else if _pick_res
        _z_top  := _res_top
        _z_bot  := _res_bot
        _z_vb   := _res_vb
        _z_vs   := _res_vs
        _z_kind := _res_kind
        _z_age  := _res_age
        _z_i    := _res_i
    else if _pick_sup
        _z_top  := _sup_top
        _z_bot  := _sup_bot
        _z_vb   := _sup_vb
        _z_vs   := _sup_vs
        _z_kind := _sup_kind
        _z_age  := _sup_age
        _z_i    := _sup_i

    ZoneStatus.new(
     _in_zone, _dist_res, _has_res, _dist_sup, _has_sup, _final_str,
     _final_res_lvl, _final_sup_lvl, _final_res_i, _final_sup_i,
     _res_kind, _res_age, _sup_kind, _sup_age,
