    float _s_dom_ratio = _attacker_vol / _own_side_avg
    bool  _s_dom = _s_dom_ratio > 1.0
    float _s_dom_score = f_score_clamp(f_score_linear(_s_dom_ratio, 0.5, 2.0, 8.0), 8.0)
    
    float _s_pressure_pct = _t.vol_total > 0 ? (_attacker_vol / _t.vol_total) * 100.0 : 50.0
    float _s_pressure_score = f_score_pressure(_s_pressure_pct)
    
    float _layer2 = f_score_clamp(_s_break_score + _s_dom_score + _s_pressure_score, 25.0)

    // ═══════════════════════════════════════════════════════════════════════
    // LAYER 3: FLOW & ENERGY (Max 20 points)
    // ═══════════════════════════════════════════════════════════════════════
    bool _e_align = math.sign(_t.vol_delta) == math.sign(_p.acc_delta)
    float _delta_strength = math.abs(_t.vol_delta) / math.max(1.0, _t.vol_total) * 100.0
    float _e_flow_score = _e_align ? f_score_clamp(4.0 + _delta_strength * 0.04, 8.0) : 0.0
    
    float _e_delta_accel = _p.acc_d_ang
    bool _accel_aligned = _is_resistance ? (_e_delta_accel > 0) : (_e_delta_accel < 0)
    float _e_delta_accel_score = _accel_aligned ? f_score_clamp(math.abs(_e_delta_accel) * 0.6, 6.0) : 0.0
    
    float _e_flow_momentum = _p.acc_tot_ang
    bool _momentum_aligned = _is_resistance ? (_e_flow_momentum > 0) : (_e_flow_momentum < 0)
    float _e_momentum_score = _momentum_aligned ? f_score_clamp(math.abs(_e_flow_momentum) * 0.6, 6.0) : 0.0
    
    float _e_shock_z = _is_resistance ? _p.v_sell_z : _p.v_buy_z
    
    float _layer3 = f_score_clamp(_e_flow_score + _e_delta_accel_score + _e_momentum_score, 20.0)

    // ═══════════════════════════════════════════════════════════════════════
    // LAYER 4: GEOMETRY (Max 15 points)
    // ═══════════════════════════════════════════════════════════════════════
    float _g_imp = math.abs(_t.vector_angle - _zone_line_ang)
    float _g_impact_score = f_score_impact_angle(_g_imp)
    
    bool _g_aln = math.sign(_t.vector_angle) == math.sign(_p.acc_tot_ang)
    float _g_vec_score = _g_aln ? f_score_clamp(3.0 + math.abs(_p.acc_tot_ang) * 0.2, 5.0) : 0.0
    
