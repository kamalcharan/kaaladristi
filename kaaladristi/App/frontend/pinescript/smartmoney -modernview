// ──────────────────────────────────────────────────────────────────────────────
// REALTIME CANDLE PREDICTION ENGINE
// ──────────────────────────────────────────────────────────────────────────────
var int   prediction_correct = 0
var int   prediction_total   = 0
var int   last_prediction    = 0

float candle_body_pct = (close - open) / (high - low == 0 ? 1 : high - low) * 100
float candle_upper_wick = high - math.max(open, close)
float candle_lower_wick = math.min(open, close) - low

float pred_score_buyer  = 0.0
float pred_score_seller = 0.0

if close > open
    pred_score_buyer += 30.0 * math.min(1.0, math.abs(candle_body_pct) / 50.0)
else if close < open
    pred_score_seller += 30.0 * math.min(1.0, math.abs(candle_body_pct) / 50.0)

if volD > 0
    pred_score_buyer += 25.0 * math.min(1.0, volD / (volT == 0 ? 1 : volT))
else
    pred_score_seller += 25.0 * math.min(1.0, math.abs(volD) / (volT == 0 ? 1 : volT))

float buy_pres = volT > 0 ? (volB / volT) * 100 : 50
float sell_pres = 100 - buy_pres
if buy_pres > 55
    pred_score_buyer += 20.0 * ((buy_pres - 50) / 50)
else if sell_pres > 55
    pred_score_seller += 20.0 * ((sell_pres - 50) / 50)

if candle_lower_wick > candle_upper_wick * 1.5
    pred_score_buyer += 15.0
else if candle_upper_wick > candle_lower_wick * 1.5
    pred_score_seller += 15.0

if close > s01
    pred_score_buyer += 10.0
else if close < s01
    pred_score_seller += 10.0

float pred_total = pred_score_buyer + pred_score_seller
float prob_buyer  = pred_total > 0 ? (pred_score_buyer / pred_total) * 100 : 50
float prob_seller = pred_total > 0 ? (pred_score_seller / pred_total) * 100 : 50

int current_prediction = prob_buyer > 55 ? 1 : prob_seller > 55 ? -1 : 0
string pred_winner = current_prediction == 1 ? "BUYERS" : current_prediction == -1 ? "SELLERS" : "NEUTRAL"
float pred_confidence = math.max(prob_buyer, prob_seller)

if barstate.isconfirmed and last_prediction != 0
    prediction_total += 1
    bool was_correct = (last_prediction == 1 and close > open) or (last_prediction == -1 and close < open)
    if was_correct
        prediction_correct += 1

if barstate.isconfirmed
    last_prediction := current_prediction

float prediction_accuracy = prediction_total > 0 ? (prediction_correct / prediction_total) * 100 : 0

