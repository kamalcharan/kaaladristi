// ──────────────────────────────────────────────────────────────────────────────
float TEST_PCT = test_dist_pct_in / 100.0

float act_dist_pct = (has_act and not na(act_lvl) and act_lvl != 0) ? (math.abs(close - act_lvl) / act_lvl * 100.0) : na

bool testing_supply = false
bool testing_demand = false

if has_act and not na(act_lvl)
    if target_is_res
        bool near_close = not na(act_dist_pct) and (act_dist_pct <= test_dist_pct_in)
        bool near_wick  = high >= act_lvl * (1.0 - TEST_PCT)
        testing_supply := require_wick_touch_in ? near_wick : near_close
    else
        bool near_close = not na(act_dist_pct) and (act_dist_pct <= test_dist_pct_in)
        bool near_wick  = low <= act_lvl * (1.0 + TEST_PCT)
        testing_demand := require_wick_touch_in ? near_wick : near_close

bool is_testing_level = testing_supply or testing_demand


