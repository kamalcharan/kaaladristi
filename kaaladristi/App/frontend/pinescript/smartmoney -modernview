f_get_safe_y(_bar, _base_y, _is_above, _spacing) =>
    float safe_y = _base_y
    int lookback = 5
    
    for i = 0 to math.min(19, array.size(label_bar_indices) - 1)
        int stored_bar = array.get(label_bar_indices, i)
        if (_bar - stored_bar) <= lookback and stored_bar > 0
            float stored_y = array.get(label_y_positions, i)
            if not na(stored_y)
                float y_diff = math.abs(safe_y - stored_y)
                if y_diff < _spacing
                    if _is_above
                        safe_y := stored_y + _spacing
                    else
                        safe_y := stored_y - _spacing
    safe_y

f_store_label_pos(_bar, _y, _is_above) =>
    array.unshift(label_bar_indices, _bar)
    array.unshift(label_y_positions, _y)
    array.unshift(label_is_above, _is_above)
    if array.size(label_bar_indices) > 20
        array.pop(label_bar_indices)
        array.pop(label_y_positions)
        array.pop(label_is_above)

