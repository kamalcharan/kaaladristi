    float _layer4 = f_score_clamp(_g_impact_score + _g_vec_score + _g_price_z_score, 15.0)

    // ═══════════════════════════════════════════════════════════════════════
    // LAYER 5: ARMY STRUCTURE (Max 15 points) — Placeholder
