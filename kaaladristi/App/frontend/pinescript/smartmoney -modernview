// ──────────────────────────────────────────────────────────────────────────────
float dist_from_lock_pct = not na(lock_price) and lock_price != 0 ? ((close - lock_price) / lock_price) * 100.0 : na
float dist_from_lock_abs = not na(lock_price) ? (close - lock_price) : na

