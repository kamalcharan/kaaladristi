    d_size  = f_getSize(size_db)
    c_txt_m = color.new(#B0BEC5, 10)
    c_bg_d  = color.new(#0D1117, 40)
    c_bg_sec= color.new(#37474F, 20)
    // ─── I) SIGNAL STATUS PANEL - Row 20 Header ───
    table.merge_cells(db_pro, 0, 20, 6, 20)

    string sig_header_txt = confirmed_state == STATE_BUYER ? "🐂 BUYERS ACTIVE" : 
                          confirmed_state == STATE_SELLER ? "🐻 SELLERS ACTIVE" : 
                          validation_status == VAL_PENDING ? "⏳ VALIDATING..." : 
                          "⏸ RANGE / FLAT"
    color sig_header_col = confirmed_state == STATE_BUYER ? color.new(#00E676, 40) : 
                          confirmed_state == STATE_SELLER ? color.new(#FF1744, 40) : 
                          validation_status == VAL_PENDING ? color.new(#FFD600, 40) :
                          c_bg_sec
    table.cell(db_pro, 0, 20, "── " + sig_header_txt + " ──", text_color=color.white, bgcolor=sig_header_col, text_size=d_size)

    // ─── Row 21: Lock Info ───
    float _dist_pct = not na(lock_price) and lock_price != 0 ? ((close - lock_price) / lock_price) * 100.0 : na
    string _pos_txt = na(_dist_pct) ? "—" : _dist_pct > 0.1 ? "▲ ABOVE" : _dist_pct < -0.1 ? "▼ BELOW" : "● AT LOCK"
    
    table.cell(db_pro, 0, 21, "LOCK PRICE", text_color=c_txt_m, bgcolor=c_bg_d, text_size=d_size, text_halign=text.align_left)
    table.cell(db_pro, 1, 21, not na(lock_price) ? str.tostring(lock_price, format.mintick) : "—", text_color=color.white, bgcolor=c_bg_d, text_size=d_size, text_halign=text.align_right)

    table.cell(db_pro, 2, 21, "RANGE ±", text_color=c_txt_m, bgcolor=c_bg_d, text_size=d_size, text_halign=text.align_left)
    table.cell(db_pro, 3, 21, str.tostring(lock_range_pct_in, "#.1") + "%", text_color=color.white, bgcolor=c_bg_d, text_size=d_size, text_halign=text.align_right)

    table.cell(db_pro, 4, 21, "POSITION", text_color=c_txt_m, bgcolor=c_bg_d, text_size=d_size, text_halign=text.align_left)
    table.cell(db_pro, 5, 21, _pos_txt, text_color=na(_dist_pct) ? color.gray : (_dist_pct > 0 ? #00E676 : _dist_pct < 0 ? #FF1744 : color.white), bgcolor=c_bg_d, text_size=d_size, text_halign=text.align_right)
    table.cell(db_pro, 6, 21, "🔒", text_color=color.white, bgcolor=c_bg_d, text_size=d_size)

    // ─── Row 22: Distance & Validation ───
    table.cell(db_pro, 0, 22, "DISTANCE", text_color=c_txt_m, bgcolor=c_bg_d, text_size=d_size, text_halign=text.align_left)
    table.cell(db_pro, 1, 22, not na(_dist_pct) ? (str.tostring(_dist_pct, "#.2") + "%") : "—", text_color=not na(_dist_pct) ? f_c_grad(_dist_pct, -1, 1) : color.gray, bgcolor=c_bg_d, text_size=d_size, text_halign=text.align_right)

    table.cell(db_pro, 2, 22, "vs RANGE", text_color=c_txt_m, bgcolor=c_bg_d, text_size=d_size, text_halign=text.align_left)
    table.cell(db_pro, 3, 22, price_vs_range, text_color=price_vs_range == "IN_RANGE" ? #00E676 : #FFD600, bgcolor=c_bg_d, text_size=d_size, text_halign=text.align_right)

    table.cell(db_pro, 4, 22, "VAL TICKS", text_color=c_txt_m, bgcolor=c_bg_d, text_size=d_size, text_halign=text.align_left)
    table.cell(db_pro, 5, 22, str.tostring(validation_ticks) + "/" + str.tostring(validation_ticks_in), text_color=validation_ticks >= validation_ticks_in ? #00E676 : #FFD600, bgcolor=c_bg_d, text_size=d_size, text_halign=text.align_right)
    table.cell(db_pro, 6, 22, validation_status == VAL_PENDING ? "⏳" : (validation_status == VAL_CONFIRMED ? "✓" : "—"), text_color=validation_status == VAL_CONFIRMED ? #00E676 : #FFD600, bgcolor=c_bg_d, text_size=d_size)

    // ─── J) PREDICTION PANEL - Row 23 Header ───
    table.merge_cells(db_pro, 0, 23, 6, 23)
    table.cell(db_pro, 0, 23, "── 📊 REALTIME PREDICTION ──", text_color=c_txt_m, bgcolor=c_bg_sec, text_size=d_size)

    // ─── Row 24: Prediction Info ───
    table.cell(db_pro, 0, 24, "WINNER", text_color=c_txt_m, bgcolor=c_bg_d, text_size=d_size, text_halign=text.align_left)
    table.cell(db_pro, 1, 24, pred_winner, text_color=current_prediction == 1 ? #00E676 : current_prediction == -1 ? #FF1744 : color.gray, bgcolor=c_bg_d, text_size=d_size, text_halign=text.align_right)

    table.cell(db_pro, 2, 24, "CONFIDENCE", text_color=c_txt_m, bgcolor=c_bg_d, text_size=d_size, text_halign=text.align_left)
    table.cell(db_pro, 3, 24, str.tostring(pred_confidence, "#.0") + "%", text_color=f_c_grad(pred_confidence, 50, 70), bgcolor=c_bg_d, text_size=d_size, text_halign=text.align_right)

    table.cell(db_pro, 4, 24, "ACCURACY", text_color=c_txt_m, bgcolor=c_bg_d, text_size=d_size, text_halign=text.align_left)
    table.cell(db_pro, 5, 24, str.tostring(prediction_accuracy, "#.1") + "%", text_color=f_c_grad(prediction_accuracy, 40, 60), bgcolor=c_bg_d, text_size=d_size, text_halign=text.align_right)
    table.cell(db_pro, 6, 24, "🎯", text_color=color.white, bgcolor=c_bg_d, text_size=d_size)

    // ─── Row 25: Prediction Stats ───
    table.cell(db_pro, 0, 25, "STATS", text_color=c_txt_m, bgcolor=c_bg_d, text_size=d_size, text_halign=text.align_left)
    table.cell(db_pro, 1, 25, str.tostring(prediction_correct) + "/" + str.tostring(prediction_total), text_color=color.white, bgcolor=c_bg_d, text_size=d_size, text_halign=text.align_right)

    table.cell(db_pro, 2, 25, "BUY PROB", text_color=c_txt_m, bgcolor=c_bg_d, text_size=d_size, text_halign=text.align_left)
    table.cell(db_pro, 3, 25, str.tostring(prob_buyer, "#") + "%", text_color=#00E676, bgcolor=c_bg_d, text_size=d_size, text_halign=text.align_right)

    table.cell(db_pro, 4, 25, "SELL PROB", text_color=c_txt_m, bgcolor=c_bg_d, text_size=d_size, text_halign=text.align_left)
    table.cell(db_pro, 5, 25, str.tostring(prob_seller, "#") + "%", text_color=#FF1744, bgcolor=c_bg_d, text_size=d_size, text_halign=text.align_right)
    table.cell(db_pro, 6, 25, "📈", text_color=color.white, bgcolor=c_bg_d, text_size=d_size)

    // ─── Row 26: Looking For ───
    string looking_txt = confirmed_state == STATE_BUYER ? "🔍 Exit or Sell Reversal" :
                         confirmed_state == STATE_SELLER ? "🔍 Exit or Buy Reversal" :
                         validation_status == VAL_PENDING ? "🔍 Confirmation..." :
                         "🔍 New Buyer or Seller"
    table.merge_cells(db_pro, 0, 26, 6, 26)
    table.cell(db_pro, 0, 26, looking_txt, text_color=#2196F3, bgcolor=c_bg_d, text_size=d_size)

    // ─── Row 27: Exit Mode Info ───
    table.merge_cells(db_pro, 0, 27, 6, 27)
    table.cell(db_pro, 0, 27, "Exit Mode: " + exit_mode_in + " | Hold: " + str.tostring(hold_bars_min_in) + " bars | SL: " + str.tostring(stop_loss_pct_in, "#.1") + "%", text_color=color.new(c_txt_m, 30), bgcolor=c_bg_d, text_size=d_size)
