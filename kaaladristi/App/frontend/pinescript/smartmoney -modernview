f_vol_engine(_model, _ltf) =>
    float buyVol = na, float sellVol = na, float totVol = na, float delta = na, bool valid = false
    if _model == "Intrabar (Precise)"
        [u, d, dl] = tvta.requestUpAndDownVolume(_ltf)
        buyVol := math.abs(u), sellVol := math.abs(d)
        totVol := buyVol + sellVol, delta := dl, valid := not na(totVol)
    else
        rng = high - low
        if rng == 0
            buyVol := volume * 0.5, sellVol := volume * 0.5
        else
            buyVol := volume * ((close - low) / rng)
            sellVol := volume * ((high - close) / rng)
        buyVol := math.max(0.0, math.min(volume, buyVol))
        sellVol := math.max(0.0, math.min(volume, sellVol))
        totVol := volume, delta := buyVol - sellVol, valid := true
    [buyVol, sellVol, totVol, delta, valid]

[volB, volS, volT, volD, volOk] = f_vol_engine(volModel, intrabarTF)

