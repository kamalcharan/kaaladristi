// C. The "Processor Brain" Function
// This function calculates ALL metrics for a given period and returns a populated "PeriodStats" object.
f_compute_period_stats(_p, _src_price, _src_vb, _src_vs, _src_vt, _src_vd) =>
    // 1. Price Dynamics
    // Calculate VWMA, its Angle, and the Z-Score of price relative to this period
    float _p_dvwma   = f_dvwma(_src_price, _src_vb, _src_vs, _p)
    float _p_ang     = f_calc_angle(_p_dvwma)
    float _p_z       = f_calc_zscore(_src_price, _p)

    // 2. Volume Dynamics (Total)
    // Calculate average volume, Z-Score of volume (spike detection), and trend of volume
    float _v_sma   = ta.sma(_src_vt, _p)
    float _v_z     = f_calc_zscore(_src_vt, _p)
    float _v_ang   = f_calc_angle(_v_sma)

    // 3. Buy/Sell Volume Specifics
    // Analyzing the specific strength of buyers vs sellers
    float _vb_sma  = ta.sma(_src_vb, _p)
    float _vb_z    = f_calc_zscore(_src_vb, _p)
    float _vs_sma  = ta.sma(_src_vs, _p)
    float _vs_z    = f_calc_zscore(_src_vs, _p)

    // 4. Accumulation & Flow (The "Life" of the period)
    // We calculate the rolling Sum of volumes over the period to see the total activity mass.
    // Then we calculate the Angle of this Sum to see if activity is accelerating or decelerating.
    
    // Total Accumulation
    float _acc_t      = math.sum(_src_vt, _p)
    float _acc_t_ang  = f_calc_angle(_acc_t)
    
    // Buy Accumulation
    float _acc_b      = math.sum(_src_vb, _p)
    float _acc_b_ang  = f_calc_angle(_acc_b)
    
    // Sell Accumulation
    float _acc_s      = math.sum(_src_vs, _p)
    float _acc_s_ang  = f_calc_angle(_acc_s)
    
    // Delta Accumulation (Net Flow)
    float _acc_d      = math.sum(_src_vd, _p)
    float _acc_d_ang  = f_calc_angle(_acc_d)

    // Return the populated Object
    PeriodStats.new(_p_dvwma, _p_ang, _p_z, _v_sma, _v_z, _v_ang, _vb_sma, _vb_z, _vs_sma, _vs_z, _acc_t, _acc_t_ang, _acc_b, _acc_b_ang, _acc_s, _acc_s_ang, _acc_d, _acc_d_ang)

// D. The "Matrix Radar" Scanner
// Scans the environment (VWMAs) relative to the Trader (Price) in the "Now"
f_scan_environment(_price, _matrix_arr) =>
    int   _w_ab = 0
    int   _w_be = 0
    float _min_dist_up = 1000000.0  // Init with huge number
    int   _idx_up      = -1         // Init Target Index (No Target)
    float _min_dist_dn = 1000000.0  // Init with huge number
    int   _idx_dn      = -1         // Init Target Index (No Target)

    // Loop through all 10 Matrix Layers
    for i = 0 to 9
        float _level = array.get(_matrix_arr, i)
        if not na(_level)
            float _dist = _level - _price
            
            if _dist > 0  // Level is Above (Resistance)
                _w_ab += 1
                if _dist < _min_dist_up
                    _min_dist_up := _dist
                    _idx_up      := i   // [TARGET LOCK] Capture the Index

            else if _dist < 0  // Level is Below (Support)
                _w_be += 1
                // _dist is negative here, we want absolute distance
                if math.abs(_dist) < _min_dist_dn
                    _min_dist_dn := math.abs(_dist)
                    _idx_dn      := i   // [TARGET LOCK] Capture the Index

            else  // _dist == 0  => PRICE IS EXACTLY ON LEVEL (TOUCH)
                // Count as both sides to avoid bias, lock both distances to 0
                _w_ab += 1
                _w_be += 1
                if 0 < _min_dist_up
                    _min_dist_up := 0
                    _idx_up      := i
                if 0 < _min_dist_dn
                    _min_dist_dn := 0
                    _idx_dn      := i
    
    // Safety check if no lines found
    if _min_dist_up == 1000000.0 
        _min_dist_up := na
        _idx_up      := -1
    if _min_dist_dn == 1000000.0 
        _min_dist_dn := na
        _idx_dn      := -1
        
    RadarScan.new(_w_ab, _w_be, _min_dist_up, _idx_up, _min_dist_dn, _idx_dn)

// E. The "Interrogator" (Layer 1 Analysis)
// Deeply analyzes the interaction between the Trader (Vector) and the Target Line (Field).
// v2.0: Full 5-layer granular scoring system (100 points max).
f_interrogate_layer1(_t, _p, _is_resistance) =>
    // _t: TraderEntity (Now)
    // _p: PeriodStats (History of the Line)
    // _is_resistance: True if attacking a Ceiling, False if attacking a Floor

    // ═══════════════════════════════════════════════════════════════════════
    // LAYER 1: VOLUME QUALITY (Max 25 points)
    // ═══════════════════════════════════════════════════════════════════════
    
    // 1A. Mass Ratio (0-10 points)
    float _avg_vol = _p.v_tot_sma == 0 ? 1.0 : _p.v_tot_sma
    float _k_rat   = _t.vol_total / _avg_vol
    bool  _k_pass  = _k_rat > 1.0
    float _k_ratio_score = f_score_k_ratio(_k_rat)
    
    // 1B. Volume Spike Z-Score (0-8 points)
    float _k_spike_z = _p.v_tot_z
    float _k_spike_score = f_score_zscore(_k_spike_z, 8.0)
    
    // 1C. Volume Trend Alignment (0-7 points)
    // Is volume trend (v_tot_ang) aligned with price direction?
    bool _vol_trend_aligned = _is_resistance ? (_p.v_tot_ang > 0) : (_p.v_tot_ang < 0)
    float _k_trend_score = _vol_trend_aligned ? f_score_clamp(math.abs(_p.v_tot_ang) * 0.7, 7.0) : 0.0
    
    float _layer1 = f_score_clamp(_k_ratio_score + _k_spike_score + _k_trend_score, 25.0)

    // ═══════════════════════════════════════════════════════════════════════
    // LAYER 2: BATTLE STRUCTURE (Max 25 points)
    // ═══════════════════════════════════════════════════════════════════════
    
    // 2A. Guard Break (0-10 points)
    float _attacker_vol = _is_resistance ? _t.vol_buy : _t.vol_sell
    float _defender_avg = _is_resistance ? _p.v_sell_sma : _p.v_buy_sma
    _defender_avg := _defender_avg == 0 ? 1.0 : _defender_avg
    float _s_break_ratio = _attacker_vol / _defender_avg
    bool  _s_break = _s_break_ratio > 1.0
    float _s_break_score = f_score_break_ratio(_s_break_ratio)
    
    // 2B. Internal Dominance (0-8 points)
    float _own_side_avg = _is_resistance ? _p.v_buy_sma : _p.v_sell_sma
    _own_side_avg := _own_side_avg == 0 ? 1.0 : _own_side_avg
    float _s_dom_ratio = _attacker_vol / _own_side_avg
    bool  _s_dom = _s_dom_ratio > 1.0
    float _s_dom_score = f_score_clamp(f_score_linear(_s_dom_ratio, 0.5, 2.0, 8.0), 8.0)
    
    // 2C. Pressure Imbalance (0-7 points)
    float _s_pressure_pct = _t.vol_total > 0 ? (_attacker_vol / _t.vol_total) * 100.0 : 50.0
    float _s_pressure_score = f_score_pressure(_s_pressure_pct)
    
    float _layer2 = f_score_clamp(_s_break_score + _s_dom_score + _s_pressure_score, 25.0)

    // ═══════════════════════════════════════════════════════════════════════
    // LAYER 3: FLOW & ENERGY (Max 20 points)
    // ═══════════════════════════════════════════════════════════════════════
    
    // 3A. Delta Alignment (0-8 points)
    bool _e_align = math.sign(_t.vol_delta) == math.sign(_p.acc_delta)
    float _delta_strength = math.abs(_t.vol_delta) / math.max(1.0, _t.vol_total) * 100.0
    float _e_flow_score = _e_align ? f_score_clamp(4.0 + _delta_strength * 0.04, 8.0) : 0.0
    
    // 3B. Delta Acceleration (0-6 points)
    float _e_delta_accel = _p.acc_d_ang
    bool _accel_aligned = _is_resistance ? (_e_delta_accel > 0) : (_e_delta_accel < 0)
    float _e_delta_accel_score = _accel_aligned ? f_score_clamp(math.abs(_e_delta_accel) * 0.6, 6.0) : 0.0
    
    // 3C. Flow Momentum (0-6 points)
    float _e_flow_momentum = _p.acc_tot_ang
    bool _momentum_aligned = _is_resistance ? (_e_flow_momentum > 0) : (_e_flow_momentum < 0)
    float _e_momentum_score = _momentum_aligned ? f_score_clamp(math.abs(_e_flow_momentum) * 0.6, 6.0) : 0.0
    
    float _e_shock_z = _p.v_tot_z  // Keep for legacy display
    
    float _layer3 = f_score_clamp(_e_flow_score + _e_delta_accel_score + _e_momentum_score, 20.0)

    // ═══════════════════════════════════════════════════════════════════════
    // LAYER 4: GEOMETRY (Max 15 points)
    // ═══════════════════════════════════════════════════════════════════════
    
    // 4A. Impact Angle (0-7 points)
    float _diff  = math.abs(_t.vector_angle - _p.p_angle)
    float _g_imp = math.min(_diff, 180.0 - _diff)
    float _g_impact_score = f_score_impact_angle(_g_imp)
    
    // 4B. Vector Alignment (0-5 points)
    bool _g_aln = math.sign(_t.vector_angle) == math.sign(_p.acc_tot_ang)
    float _g_vec_score = _g_aln ? f_score_clamp(3.0 + math.abs(_p.acc_tot_ang) * 0.2, 5.0) : 0.0
    
    // 4C. Price Z-Score Position (0-3 points)
    float _g_price_z = _p.p_zscore
    // Extreme positions (|Z| > 1.5) in the "right" direction get bonus
    bool _price_extreme_ok = _is_resistance ? (_g_price_z > 1.0) : (_g_price_z < -1.0)
    float _g_price_z_score = _price_extreme_ok ? f_score_clamp(math.abs(_g_price_z) * 1.0, 3.0) : 0.0
    
    float _layer4 = f_score_clamp(_g_impact_score + _g_vec_score + _g_price_z_score, 15.0)

    // ═══════════════════════════════════════════════════════════════════════
    // LAYER 5: ARMY STRUCTURE (Max 15 points) — Placeholder (filled by caller)
    // ═══════════════════════════════════════════════════════════════════════
    // These scores are computed from HierarchyStatus and injected after creation.
    float _a_stack_score      = 0.0
    float _a_confluence_score = 0.0
    float _a_trend_score      = 0.0
    float _layer5             = 0.0

    // ═══════════════════════════════════════════════════════════════════════
    // FINAL SCORE & GRADE
    // ═══════════════════════════════════════════════════════════════════════
    float _total = _layer1 + _layer2 + _layer3 + _layer4 + _layer5
    string _grade = f_score_to_grade(_total)

    InteractionResult.new(
         _k_rat, _k_pass, _k_ratio_score, _k_spike_z, _k_spike_score, _k_trend_score, _layer1,
         _s_break, _s_break_ratio, _s_break_score, _s_dom, _s_dom_ratio, _s_dom_score, _s_pressure_pct, _s_pressure_score, _layer2,
         _e_align, _e_flow_score, _e_shock_z, _e_delta_accel, _e_delta_accel_score, _e_flow_momentum, _e_momentum_score, _layer3,
         _g_imp, _g_impact_score, _g_aln, _g_vec_score, _g_price_z, _g_price_z_score, _layer4,
         _a_stack_score, _a_confluence_score, _a_trend_score, _layer5,
         _total, _grade)


