// Helper: Find nearest level above current price for specific metric
f_findNearestAboveByMetric(array<ZLevel> levels, float currentPrice, string metricName) =>
    ZLevel nearest = na
    float minDist = 1e10
    int size = array.size(levels)
    if size > 0
        for i = 0 to size - 1
            ZLevel lvl = array.get(levels, i)
            if lvl.metric == metricName and lvl.price > currentPrice
                float dist = lvl.price - currentPrice
                if dist < minDist
                    minDist := dist
                    nearest := lvl
    nearest

// Helper: Find nearest level below current price for specific metric
f_findNearestBelowByMetric(array<ZLevel> levels, float currentPrice, string metricName) =>
    ZLevel nearest = na
    float minDist = 1e10
    int size = array.size(levels)
    if size > 0
        for i = 0 to size - 1
            ZLevel lvl = array.get(levels, i)
            if lvl.metric == metricName and lvl.price < currentPrice
                float dist = currentPrice - lvl.price
                if dist < minDist
                    minDist := dist
                    nearest := lvl
    nearest

// Helper: Find all levels at a specific price (for combined labels)
f_findLevelsAtPrice(array<ZLevel> levels, float targetPrice, float tolerance) =>
    array<ZLevel> result = array.new<ZLevel>()
    int size = array.size(levels)
    if size > 0
        for i = 0 to size - 1
            ZLevel lvl = array.get(levels, i)
            if math.abs(lvl.price - targetPrice) <= tolerance
                array.push(result, lvl)
    result

