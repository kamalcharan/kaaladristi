//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
type VolumeData
    float total
    float buy
    float sell
    float delta

// Method: Calculate using Geometry approximation
method calcGeometry(VolumeData this, int offset) =>
    float h   = high[offset]
    float l   = low[offset]
    float c   = close[offset]
    float v   = volume[offset]
    float rng = h - l
    
    if na(v) or v == 0
        this.total := 0.0
        this.buy   := 0.0
        this.sell  := 0.0
        this.delta := 0.0
    else if rng == 0
        this.total := v
        this.buy   := v * 0.5
        this.sell  := v * 0.5
        this.delta := 0.0
    else
        this.total := v
        this.buy   := v * ((c - l) / rng)
        this.sell  := v * ((h - c) / rng)
        this.delta := this.buy - this.sell
    this

// Method: Calculate using Intrabar (LTF) data
method calcIntrabar(VolumeData this, float u, float d, float dl, int offset) =>
    this.buy   := math.abs(u[offset])
    this.sell  := math.abs(d[offset])
    this.total := this.buy + this.sell
    this.delta := dl[offset]
    this

