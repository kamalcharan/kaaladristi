// UDT: Z-SCORE DATA CONTAINER
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
type ZScoreData
    float raw       // Raw Z-Score value
    string status   // Interpretation status
    color clr       // Display color

// Method: Calculate Z-Score for any source
method calcZ(ZScoreData this, float src, int period) =>
    float mean   = ta.sma(src, period)
    float stdDev = ta.stdev(src, period)
    float rawZ   = stdDev != 0 ? (src - mean) / stdDev : 0.0
    
    this.raw := rawZ
    
    // Determine status and color based on raw Z value (localized)
    if rawZ >= Z_THRESHOLD_HIGH
        this.status := f_L3("▲▲ Extreme High", "▲▲ Aşırı Yüksek", "▲▲ 극단적 고점")
        this.clr    := COLOR_BULL
    else if rawZ >= Z_THRESHOLD_MED
        this.status := f_L3("▲ Above Avg", "▲ Ort. Üstü", "▲ 평균 이상")
        this.clr    := color.new(COLOR_BULL, 40)
    else if rawZ <= -Z_THRESHOLD_HIGH
        this.status := f_L3("▼▼ Extreme Low", "▼▼ Aşırı Düşük", "▼▼ 극단적 저점")
        this.clr    := COLOR_BEAR
    else if rawZ <= -Z_THRESHOLD_MED
        this.status := f_L3("▼ Below Avg", "▼ Ort. Altı", "▼ 평균 이하")
        this.clr    := color.new(COLOR_BEAR, 40)
    else
        this.status := f_L3("○ Normal", "○ Normal", "○ 보통")
        this.clr    := COLOR_NEUTRAL
    this

