//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
type EventClassifier
    array<EventResult> activeEvents   // Currently active events
    ZSnapshot          snapshot       // Current Z-score snapshot
    int                totalChecked   // Total scenarios checked
    int                totalTriggered // Total events triggered
    EventResult        strongestEvent // Highest confidence event

// Method: Initialize classifier
method init(EventClassifier this) =>
    this.activeEvents := array.new<EventResult>()
    this.snapshot := ZSnapshot.new()
    this.totalChecked := 0
    this.totalTriggered := 0
    this.strongestEvent := na
    this

// Method: Clear previous results
method clear(EventClassifier this) =>
    array.clear(this.activeEvents)
    this.totalChecked := 0
    this.totalTriggered := 0
    this.strongestEvent := na
    this

// Method: Add detected event
method addEvent(EventClassifier this, EventResult evt) =>
    array.push(this.activeEvents, evt)
    this.totalTriggered += 1
    
    // Track strongest event
    if na(this.strongestEvent) or evt.confidence > this.strongestEvent.confidence
        this.strongestEvent := evt
    this

// Method: Get events by category
method getByCategory(EventClassifier this, int cat) =>
    array<EventResult> result = array.new<EventResult>()
    int n = array.size(this.activeEvents)
    if n > 0
        for i = 0 to n - 1
            EventResult evt = array.get(this.activeEvents, i)
            if evt.category == cat
                array.push(result, evt)
    result

// Method: Get events by direction
method getByDirection(EventClassifier this, int dir) =>
    array<EventResult> result = array.new<EventResult>()
    int n = array.size(this.activeEvents)
    if n > 0
        for i = 0 to n - 1
            EventResult evt = array.get(this.activeEvents, i)
            if evt.direction == dir
                array.push(result, evt)
    result

// Method: Get top N events by confidence
method getTopEvents(EventClassifier this, int topN) =>
    array<EventResult> result = array.new<EventResult>()
    array<EventResult> sorted = array.copy(this.activeEvents)
    int n = array.size(sorted)
    
    // Sort by confidence (descending) using bubble sort
    if n > 1
        for i = 0 to n - 2
            for j = 0 to n - i - 2
                EventResult a = array.get(sorted, j)
                EventResult b = array.get(sorted, j + 1)
                if b.confidence > a.confidence
                    array.set(sorted, j, b)
                    array.set(sorted, j + 1, a)
    
    // Take top N
    int limit = math.min(topN, n)
    if limit > 0
        for i = 0 to limit - 1
            array.push(result, array.get(sorted, i))
    result

// Method: Calculate overall market bias
method calcMarketBias(EventClassifier this) =>
    float bullScore = 0.0
    float bearScore = 0.0
    float neutralScore = 0.0
    
    int n = array.size(this.activeEvents)
    if n > 0
        for i = 0 to n - 1
            EventResult evt = array.get(this.activeEvents, i)
            if evt.direction == EVT_DIR_BULL
                bullScore += evt.confidence
            else if evt.direction == EVT_DIR_BEAR
                bearScore += evt.confidence
            else
                neutralScore += evt.confidence
    
    [bullScore, bearScore, neutralScore]

