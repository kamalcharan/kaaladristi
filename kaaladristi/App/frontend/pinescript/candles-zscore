        string evtHeaderTxt = "⚡ " + f_L3("Event Detection", "Olay Tespiti", "이벤트 감지") + " [" + str.tostring(eventEngine.totalTriggered) + "/" + str.tostring(eventEngine.totalChecked) + "]"
        table.cell(dashT, 0, 7, evtHeaderTxt, text_color = COLOR_TXT_HDR, bgcolor = COLOR_HDR_BG, text_size = textSize, text_halign = text.align_left,
             tooltip = f_L3("Event Detection Engine\n\nAnalyzes 60 market scenarios based on Z-Score combinations.\nShows: [Triggered Events / Total Scenarios Checked]\n\nCategories:\n• A: Price-Volume (1-10)\n• B: Order-Flow (11-16)\n• C: Buy vs Sell (17-23)\n• D: Predictability (24-26)\n• E: Reversal/Continuation (27-30)\n• F: Imbalance Lag (31-33)\n• G: Support/Resistance (34-36)\n• H: Extended Analysis (37-50)\n• I: Trend-Integrated (51-60)",
                            "Olay Tespit Motoru\n\nZ-Skor kombinasyonlarına dayalı 60 piyasa senaryosunu analiz eder.\nGösterim: [Tetiklenen Olaylar / Toplam Kontrol Edilen]\n\nKategoriler:\n• A: Fiyat-Hacim (1-10)\n• B: Emir Akışı (11-16)\n• C: Alım vs Satım (17-23)\n• D: Öngörülebilirlik (24-26)\n• E: Dönüş/Devam (27-30)\n• F: Dengesizlik Gecikmesi (31-33)\n• G: Destek/Direnç (34-36)\n• H: Genişletilmiş Analiz (37-50)\n• I: Trend Entegre (51-60)",
                            "이벤트 감지 엔진\n\nZ-점수 조합을 기반으로 60가지 시장 시나리오를 분석합니다.\n표시: [트리거된 이벤트 / 총 검사 시나리오]\n\n카테고리:\n• A: 가격-거래량 (1-10)\n• B: 주문 흐름 (11-16)\n• C: 매수 vs 매도 (17-23)\n• D: 예측 가능성 (24-26)\n• E: 반전/지속 (27-30)\n• F: 불균형 지연 (31-33)\n• G: 지지/저항 (34-36)\n• H: 확장 분석 (37-50)\n• I: 추세 통합 (51-60)"))
        table.merge_cells(dashT, 0, 7, DASH_COLS - 1, 7)
        
        // === ROW 8: MARKET BIAS ===
        // Calculate bias percentages
        float totalBiasScore = bullScore + bearScore + neutralScore
        float bullPct  = totalBiasScore > 0 ? (bullScore / totalBiasScore) * 100.0 : 0.0
        float bearPct  = totalBiasScore > 0 ? (bearScore / totalBiasScore) * 100.0 : 0.0
        float neutPct  = totalBiasScore > 0 ? (neutralScore / totalBiasScore) * 100.0 : 0.0
        
        // Determine dominant bias (localized)
        string biasDir = bullScore > bearScore ? 
             (bullScore > neutralScore ? f_L3("BULL", "BOĞA", "강세") : f_L3("NEUTRAL", "NÖTR", "중립")) : 
             (bearScore > neutralScore ? f_L3("BEAR", "AYI", "약세") : f_L3("NEUTRAL", "NÖTR", "중립"))
        color  biasClr = biasDir == "BULL" ? COLOR_BULL : (biasDir == "BEAR" ? COLOR_BEAR : COLOR_NEUTRAL)
        
        // Build bias bar visual
        int bullBars = int(math.round(bullPct / 10.0))
        int bearBars = int(math.round(bearPct / 10.0))
        int neutBars = 10 - bullBars - bearBars
        neutBars := math.max(0, neutBars)
        
        string biasBar = ""
        if bullBars > 0
            for i = 1 to bullBars
                biasBar += "▓"
        if neutBars > 0
            for i = 1 to neutBars
                biasBar += "░"
        if bearBars > 0
            for i = 1 to bearBars
                biasBar += "▓"
        
        table.cell(dashT, 0, 8, f_L3("Market Bias", "Piyasa Eğilimi", "시장 편향"), text_color = COLOR_TXT_DIM, bgcolor = COLOR_ROW_BG, text_size = textSize, text_halign = text.align_left,
             tooltip = f_L3("Overall market bias based on triggered events.\n\nCalculated from confidence-weighted event directions:\n• Bullish events add to Bull score\n• Bearish events add to Bear score\n• Neutral/Warning events add to Neutral score",
                            "Tetiklenen olaylara dayalı genel piyasa eğilimi.\n\nGüven ağırlıklı olay yönlerinden hesaplanır:\n• Yükseliş olayları Boğa skoruna eklenir\n• Düşüş olayları Ayı skoruna eklenir\n• Nötr/Uyarı olayları Nötr skora eklenir",
                            "트리거된 이벤트를 기반으로 한 전체 시장 편향.\n\n신뢰도 가중 이벤트 방향에서 계산됨:\n• 강세 이벤트는 Bull 점수에 추가\n• 약세 이벤트는 Bear 점수에 추가\n• 중립/경고 이벤트는 중립 점수에 추가"))
        table.cell(dashT, 1, 8, biasDir, text_color = biasClr, bgcolor = COLOR_ROW_BG, text_size = textSize, text_halign = text.align_center)
        table.cell(dashT, 2, 8, biasBar, text_color = biasClr, bgcolor = COLOR_ROW_BG, text_size = textSize, text_halign = text.align_center, text_font_family = font.family_monospace)
        table.merge_cells(dashT, 2, 8, 4, 8)
        
        string biasPctTxt = "▲" + str.tostring(bullPct, "#") + "% │ ▼" + str.tostring(bearPct, "#") + "%"
        table.cell(dashT, 5, 8, biasPctTxt, text_color = COLOR_TXT_VAL, bgcolor = COLOR_ROW_BG, text_size = textSize, text_halign = text.align_center,
             tooltip = "Bull: " + str.tostring(bullPct, "#.#") + "% (" + str.tostring(bullScore, "#.#") + " pts)\n" +
                       "Bear: " + str.tostring(bearPct, "#.#") + "% (" + str.tostring(bearScore, "#.#") + " pts)\n" +
                       "Neutral: " + str.tostring(neutPct, "#.#") + "% (" + str.tostring(neutralScore, "#.#") + " pts)")
        table.merge_cells(dashT, 5, 8, 6, 8)
        
        // === ROW 9: STRONGEST EVENT ===
        string strongestName = na(eventEngine.strongestEvent) ? "—" : eventEngine.strongestEvent.eventName
        string strongestConf = na(eventEngine.strongestEvent) ? "" : str.tostring(eventEngine.strongestEvent.confidence, "#") + "%"
        color  strongestClr  = na(eventEngine.strongestEvent) ? COLOR_TXT_DIM : 
             (eventEngine.strongestEvent.direction == EVT_DIR_BULL ? COLOR_BULL : 
              eventEngine.strongestEvent.direction == EVT_DIR_BEAR ? COLOR_BEAR : 
              eventEngine.strongestEvent.direction == EVT_DIR_WARNING ? COLOR_YELLOW : COLOR_NEUTRAL)
        string strongestDir  = na(eventEngine.strongestEvent) ? "" : f_directionName(eventEngine.strongestEvent.direction)
        
        table.cell(dashT, 0, 9, f_L3("Strongest", "En Güçlü", "최강"), text_color = COLOR_TXT_DIM, bgcolor = COLOR_ROW_BG, text_size = textSize, text_halign = text.align_left,
             tooltip = f_L3("Highest confidence event currently triggered.\n\nConfidence is calculated based on:\n• Primary Z-Score magnitude\n• Secondary/Tertiary alignment\n• Direction consistency bonus",
                            "Şu anda tetiklenen en yüksek güvenilirlikli olay.\n\nGüvenilirlik şunlara göre hesaplanır:\n• Birincil Z-Skor büyüklüğü\n• İkincil/Üçüncül uyum\n• Yön tutarlılığı bonusu",
                            "현재 트리거된 가장 높은 신뢰도 이벤트.\n\n신뢰도는 다음을 기준으로 계산됩니다:\n• 기본 Z-점수 크기\n• 보조/삼차 정렬\n• 방향 일관성 보너스"))
        table.cell(dashT, 1, 9, strongestName, text_color = strongestClr, bgcolor = COLOR_ROW_BG, text_size = textSize, text_halign = text.align_left)
        table.merge_cells(dashT, 1, 9, 4, 9)
        table.cell(dashT, 5, 9, strongestDir, text_color = strongestClr, bgcolor = COLOR_ROW_BG, text_size = textSize, text_halign = text.align_center)
        table.cell(dashT, 6, 9, strongestConf, text_color = strongestClr, bgcolor = COLOR_ROW_BG, text_size = textSize, text_halign = text.align_right)
        
        // === ROW 10: TOP EVENTS LIST (up to 2 more) ===
        array<EventResult> topEvents = eventEngine.getTopEvents(3)
        int topCount = array.size(topEvents)
        
        string evt2Name = topCount > 1 ? array.get(topEvents, 1).eventName : "—"
        string evt2Conf = topCount > 1 ? str.tostring(array.get(topEvents, 1).confidence, "#") + "%" : ""
        color  evt2Clr  = topCount > 1 ? 
             (array.get(topEvents, 1).direction == EVT_DIR_BULL ? COLOR_BULL : 
              array.get(topEvents, 1).direction == EVT_DIR_BEAR ? COLOR_BEAR : 
              array.get(topEvents, 1).direction == EVT_DIR_WARNING ? COLOR_YELLOW : COLOR_NEUTRAL) : COLOR_TXT_DIM
        string evt2Dir  = topCount > 1 ? f_directionName(array.get(topEvents, 1).direction) : ""
        
        table.cell(dashT, 0, 10, "#2", text_color = COLOR_TXT_DIM, bgcolor = COLOR_ROW_BG, text_size = textSize, text_halign = text.align_left)
        table.cell(dashT, 1, 10, evt2Name, text_color = evt2Clr, bgcolor = COLOR_ROW_BG, text_size = textSize, text_halign = text.align_left)
        table.merge_cells(dashT, 1, 10, 4, 10)
        table.cell(dashT, 5, 10, evt2Dir, text_color = evt2Clr, bgcolor = COLOR_ROW_BG, text_size = textSize, text_halign = text.align_center)
        table.cell(dashT, 6, 10, evt2Conf, text_color = evt2Clr, bgcolor = COLOR_ROW_BG, text_size = textSize, text_halign = text.align_right)
        
        // === ROW 11: FOOTER/ENGINE INFO ===
        string engineTxt  = i_calcMethod == "Intrabar (Precise)" ? "Intrabar (" + ltfResolved + ")" : f_L3("Geometry", "Geometri", "기하학")
        string engineLbl  = f_L3("Engine", "Motor", "엔진")
        string periodLbl  = f_L3("Period", "Periyot", "기간")
        string basisLbl   = f_L3("Basis", "Temel", "기준")
        string validLbl   = f_L3("Valid", "Geçerli", "유효")
        string engineInfo = engineLbl + ": " + engineTxt + " │ " + periodLbl + ": " + str.tostring(i_zPeriod) + " │ " + basisLbl + ": " + basisLabelL10n + " │ " + validLbl + ": " + validTxt
        
        bool   insufficientData = i_calcMethod == "Intrabar (Precise)" and scannableBars < i_zPeriod
        string warningMsg       = f_L3("⚠️ Only " + str.tostring(scannableBars) + " valid bars — need " + str.tostring(i_zPeriod) + ".\nTry a higher LTF or\nsmaller chart timeframe.",
                                       "⚠️ Sadece " + str.tostring(scannableBars) + " geçerli bar — " + str.tostring(i_zPeriod) + " gerekli.\nDaha yüksek LTF veya\ndaha küçük grafik zaman dilimi deneyin.",
                                       "⚠️ 유효한 봉 " + str.tostring(scannableBars) + "개만 — " + str.tostring(i_zPeriod) + "개 필요.\n더 높은 LTF 또는\n더 작은 차트 타임프레임을 시도하세요.")

        bool   hasLblWarn       = dashLabelOverlapWarn != ""
        string footerTextBase   = insufficientData ? warningMsg : engineInfo
        string footerText       = hasLblWarn ? (footerTextBase + "\n" + dashLabelOverlapWarn) : footerTextBase
        color  footerClr        = (insufficientData or hasLblWarn) ? color.rgb(251, 191, 36) : COLOR_TXT_DIM
        
        table.cell(dashT, 0, 11, footerText, text_color = footerClr, bgcolor = COLOR_HDR_BG, text_size = textSize, text_halign = text.align_left,
             tooltip = f_L3("Volume Engine Method:\n• Geometry: Approximates buy/sell from candle structure\n• Intrabar: Uses lower timeframe for precision\n\nValid Data (Scannable):\n• Intrabar shows consecutive usable bars as scannable/available\n• Geometry is always available up to history\n\nZ-Score Period: " + str.tostring(i_zPeriod) + " bars\n\nCalculation Basis:\n• LIVE: Current candle (may repaint)\n• CLOSED: Last confirmed candle (stable)",
                            "Hacim Motoru Yöntemi:\n• Geometri: Mum yapısından alım/satımı tahmin eder\n• Intrabar: Hassasiyet için alt zaman dilimi kullanır\n\nGeçerli Veri (Taranabilir):\n• Intrabar ardışık kullanılabilir barları gösterir\n• Geometri her zaman geçmişe kadar mevcuttur\n\nZ-Skor Periyodu: " + str.tostring(i_zPeriod) + " bar\n\nHesaplama Temeli:\n• CANLI: Mevcut mum (yeniden çizebilir)\n• KAPALI: Son onaylanmış mum (kararlı)",
                            "거래량 엔진 방식:\n• 기하학: 캔들 구조에서 매수/매도 추정\n• Intrabar: 정밀도를 위해 하위 타임프레임 사용\n\n유효 데이터 (스캔 가능):\n• Intrabar는 연속 사용 가능한 봉을 표시\n• 기하학은 항상 과거까지 사용 가능\n\nZ-점수 기간: " + str.tostring(i_zPeriod) + "봉\n\n계산 기준:\n• 실시간: 현재 캔들 (다시 그릴 수 있음)\n• 확정: 마지막 확정 캔들 (안정적)"))
        table.merge_cells(dashT, 0, 11, DASH_COLS - 1, 11)

    else
        // Hide table by clearing all cells
        table.clear(dashT, 0, 0, DASH_COLS - 1, DASH_ROWS - 1)
