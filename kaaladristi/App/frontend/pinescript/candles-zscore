        string upperLbl = f_L3("Upper", "Üst", "상단")
        string lowerLbl = f_L3("Lower", "Alt", "하단")
        
        string upperTxt = "▲ " + trendName + " " + upperLbl + " | " + str.tostring(upperY, format.mintick) + 
