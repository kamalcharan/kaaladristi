// Helper: Create visual Z-bar (heatmap style)
f_zBar(float z) =>
    float zClamped = math.max(-3.0, math.min(3.0, nz(z, 0)))
    int barLen = 10
    int midPoint = 5
    int fillPos = int(math.round((zClamped + 3) / 6 * barLen))
    
    string result = ""
    for i = 0 to barLen - 1
        if i == midPoint
            result += "|"
        else if (zClamped >= 0 and i > midPoint and i <= fillPos) or (zClamped < 0 and i < midPoint and i >= fillPos)
            result += "█"
        else
            result += "░"
    result

