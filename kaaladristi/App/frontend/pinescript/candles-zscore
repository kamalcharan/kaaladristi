    // Get events to display (filtered by confidence if enabled)
    array<EventResult> eventsToShow = array.new<EventResult>()
    
    int totalEvents = array.size(eventEngine.activeEvents)
    if totalEvents > 0
        // Filter and collect events
        for i = 0 to totalEvents - 1
            EventResult evt = array.get(eventEngine.activeEvents, i)
            bool passFilter = i_showOnlyStrong ? (evt.confidence >= CONF_MEDIUM) : true
            if passFilter
                array.push(eventsToShow, evt)
        
        // Sort by confidence (descending)
        int numToShow = array.size(eventsToShow)
        if numToShow > 1
            for i = 0 to numToShow - 2
                for j = 0 to numToShow - i - 2
                    EventResult a = array.get(eventsToShow, j)
                    EventResult b = array.get(eventsToShow, j + 1)
                    if b.confidence > a.confidence
                        array.set(eventsToShow, j, b)
                        array.set(eventsToShow, j + 1, a)
        
        // Limit to max markers per bar
        int drawCount = math.min(numToShow, i_maxMarkersPerBar)
        
        // Draw markers for top events
        if drawCount > 0
            for i = 0 to drawCount - 1
                EventResult evt = array.get(eventsToShow, i)
                
