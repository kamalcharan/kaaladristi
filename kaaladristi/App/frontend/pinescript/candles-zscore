//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
type ZSnapshot
    float Zp        // Price Z-Score
    float Zv        // Total Volume Z-Score
    float Zbuy      // Buy Volume Z-Score
    float Zsell     // Sell Volume Z-Score
    float Zdelta    // Delta Z-Score
    int   dirP      // Price direction: 1=up, -1=down, 0=neutral
    float Zp_1      // Previous bar Zp
    float Zdelta_1  // Previous bar Zdelta

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// UDT: EVENT RESULT
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
type EventResult
    int     eventId       // 1-60
    string  eventName     // Localized name
    int     category      // EVT_CAT_*
    int     direction     // EVT_DIR_*
    float   confidence    // 0-100
    string  academicBasis // Citation reference
    bool    isActive      // Currently triggered
    int     barIdx        // Bar index when detected

// Method: Calculate confidence score based on Z-score magnitudes
method calcConfidence(EventResult this, float primaryZ, float secondaryZ, float tertiaryZ) =>
    // Base confidence from primary Z-score magnitude
    float baseConf = math.min(100.0, math.abs(primaryZ) * 25.0)
    
    // Boost from secondary alignment
    float secBoost = na(secondaryZ) ? 0.0 : math.min(20.0, math.abs(secondaryZ) * 10.0)
    
    // Boost from tertiary alignment
    float terBoost = na(tertiaryZ) ? 0.0 : math.min(10.0, math.abs(tertiaryZ) * 5.0)
    
    // Alignment bonus: if all Z-scores point same direction
    float alignBonus = 0.0
    if not na(secondaryZ) and math.sign(primaryZ) == math.sign(secondaryZ)
        alignBonus += 5.0
    if not na(tertiaryZ) and math.sign(primaryZ) == math.sign(tertiaryZ)
        alignBonus += 5.0
    
    this.confidence := math.min(100.0, baseConf + secBoost + terBoost + alignBonus)
    this

