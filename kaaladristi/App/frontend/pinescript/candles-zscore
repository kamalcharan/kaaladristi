    f_ensureBlockCount(i_numGroups)
    
    // Reset trend locks for fresh calculation
    for gi = 0 to i_numGroups - 1
        BlockAnalytics blk = array.get(blockData, gi)
        blk.trendLocked := false
        array.set(blockData, gi, blk)
    
    // Calculate each block's OHLC from the Z-Score period
    for gi = 0 to i_numGroups - 1
        int startOff = baseOff + gi * i_zPeriod
        int endOff = baseOff + (gi + 1) * i_zPeriod - 1
        
        float blockHi = na
        float blockLo = na
        float blockOp = na
        float blockCl = na
        float sumBuy = 0.0
        float sumSell = 0.0
        
        for k = startOff to endOff
            float h = high[k]
            float l = low[k]
            float o = open[k]
            float c = close[k]
            
            if na(blockHi) or h > blockHi
                blockHi := h
            if na(blockLo) or l < blockLo
                blockLo := l
            
            if k == endOff
                blockOp := o
            if k == startOff
                blockCl := c
            
            // Accumulate volume
            sumBuy += nz(volData.buy, 0)
            sumSell += nz(volData.sell, 0)
        
        int xRight = bar_index - startOff
        int xLeft = bar_index - endOff
        int xCenter = int(math.round((xLeft + xRight) / 2.0))
        
        BlockAnalytics ba = BlockAnalytics.new(true,
             sumBuy, sumSell, sumBuy - sumSell,
             blockHi, blockLo, blockOp, blockCl,
             xLeft, xRight, xCenter, DIR_RANGE, false)
        array.set(blockData, gi, ba)
    
    // Clear old channels and detect new ones
    f_clearAllChannels()
    f_detectTrendChannels(i_rangeAngleThreshold, globalAtr14)
    
    // Draw channels
