// CLUSTERING (merge overlapping lines into one label/line)
// Returns: [clusterPrices, clusterX1Bars, levelClusterIds]
// ─────────────────────────────────────────────────────────────────────────────
f_clusterAssign(array<ZLevel> lvls, float tol) =>
    array<float> cPrice = array.new<float>()
    array<int>   cX1    = array.new<int>()
    array<int>   ids    = array.new<int>()

    int n = array.size(lvls)
    if n > 0
        for i = 0 to n - 1
            ZLevel lvl = array.get(lvls, i)

            int cid = -1
            int m = array.size(cPrice)
            if m > 0
                for j = 0 to m - 1
                    bool hit = math.abs(lvl.price - array.get(cPrice, j)) <= tol
                    if hit and cid == -1
                        cid := j

            if cid == -1
                cid := array.size(cPrice)
                array.push(cPrice, lvl.price)
                array.push(cX1, lvl.barIdx)
            else
                int prevX1 = array.get(cX1, cid)
                if lvl.barIdx < prevX1
                    array.set(cX1, cid, lvl.barIdx)

            array.push(ids, cid)

    [cPrice, cX1, ids]

// ─────────────────────────────────────────────────────────────────────────────
// LABEL ANTI-OVERLAP (Percent-gap stacking + capped offset + dashboard warnings)
// Upper: keep lowest fixed; stack higher upward.
// Lower: keep highest fixed; stack lower downward.
// ─────────────────────────────────────────────────────────────────────────────
f_argsortByY(array<float> ys, bool asc) =>
    int n = array.size(ys)
    array<int> idx = array.new<int>()
    if n > 0
        for i = 0 to n - 1
            array.push(idx, i)
        if n > 1
            for i = 0 to n - 2
                int best = i
                for j = i + 1 to n - 1
                    int iBest = array.get(idx, best)
                    int iJ    = array.get(idx, j)
                    float yB  = array.get(ys, iBest)
                    float yJv = array.get(ys, iJ)
                    bool better = asc ? (yJv < yB) : (yJv > yB)
                    if better
                        best := j
                if best != i
                    int tmp = array.get(idx, i)
                    array.set(idx, i, array.get(idx, best))
                    array.set(idx, best, tmp)
    idx

f_resolveLabelY(array<float> baseY, bool isUpper, float refP, float gapPct, float maxOffAbs) =>
    int n = array.size(baseY)
    array<float> disp = array.new_float(n, na)
    string warn = ""

    if n == 0
        [disp, warn]
    else
        float refAbs = math.max(syminfo.mintick, math.abs(refP))
        float gapAbs = refAbs * gapPct

        array<int> order = f_argsortByY(baseY, isUpper)  // Upper: asc, Lower: desc

        float prevDisp = na
        int   prevCi   = na
        int   warnCnt  = 0

        for k = 0 to n - 1
            int ci = array.get(order, k)
            float y0 = array.get(baseY, ci)
            float yD = y0

            if k == 0
                yD := y0
            else
                if isUpper
                    if y0 - prevDisp < gapAbs
                        yD := prevDisp + gapAbs
                else
                    if prevDisp - y0 < gapAbs
                        yD := prevDisp - gapAbs

            float off = yD - y0
            bool clamped = false
            if maxOffAbs > 0 and math.abs(off) > maxOffAbs
                yD := y0 + (off > 0 ? maxOffAbs : -maxOffAbs)
                clamped := true

            if k > 0
                bool violates = isUpper ? (yD - prevDisp < gapAbs) : (prevDisp - yD < gapAbs)
                if clamped and violates and warnCnt < 3
                    float yPrev0 = array.get(baseY, prevCi)
                    float dp = math.abs(yPrev0 - y0) / refAbs * 100.0
                    string line = "⚠ Label overlap: " + str.tostring(yPrev0, format.mintick) + " vs " + str.tostring(y0, format.mintick) +
                                  " (Δ=" + str.tostring(dp, "#.##") + "%)"
                    warn := warn == "" ? line : (warn + "\n" + line)
                    warnCnt += 1

            array.set(disp, ci, yD)
            prevDisp := yD
            prevCi   := ci

        [disp, warn]

// Helper: Build combined label text for multiple metrics at same level
f_buildCombinedLabel(array<ZLevel> levels, bool isUpper, float lineY) =>
    string arrow  = isUpper ? "▲" : "▼"
    // Always show the actual line Y clearly (prevents 3.29 vs 3.30 ambiguity)
    string levelLbl = f_L3("LEVEL (Line Y)", "SEVİYE (Çizgi Y)", "레벨 (라인 Y)")
    string result = levelLbl + ": " + str.tostring(lineY, format.mintick)

    // Display polish:
    // - One entry per metric (Price/Volume/Buy/Sell/Delta)
    // - If multiple entries exist for the same metric, keep the one with the closest price to lineY
    //   (tie-breaker: newer barIdx wins)
    ZLevel bestPrice  = na
    ZLevel bestVolume = na
    ZLevel bestBuy    = na
    ZLevel bestSell   = na
    ZLevel bestDelta  = na

    float dPrice  = 1e10
    float dVolume = 1e10
    float dBuy    = 1e10
    float dSell   = 1e10
    float dDelta  = 1e10

    int bPrice  = -1
    int bVolume = -1
    int bBuy    = -1
    int bSell   = -1
    int bDelta  = -1

    int size = array.size(levels)
    if size > 0
        for i = 0 to size - 1
            ZLevel lvl = array.get(levels, i)
            float dist = math.abs(lvl.price - lineY)

            if lvl.metric == "Price"
                if dist < dPrice or (dist == dPrice and lvl.barIdx > bPrice)
                    dPrice := dist
                    bPrice := lvl.barIdx
                    bestPrice := lvl
            else if lvl.metric == "Volume"
                if dist < dVolume or (dist == dVolume and lvl.barIdx > bVolume)
                    dVolume := dist
                    bVolume := lvl.barIdx
                    bestVolume := lvl
            else if lvl.metric == "Buy"
                if dist < dBuy or (dist == dBuy and lvl.barIdx > bBuy)
                    dBuy := dist
                    bBuy := lvl.barIdx
                    bestBuy := lvl
            else if lvl.metric == "Sell"
                if dist < dSell or (dist == dSell and lvl.barIdx > bSell)
                    dSell := dist
                    bSell := lvl.barIdx
                    bestSell := lvl
            else if lvl.metric == "Delta"
                if dist < dDelta or (dist == dDelta and lvl.barIdx > bDelta)
                    dDelta := dist
                    bDelta := lvl.barIdx
                    bestDelta := lvl

    bool any = false

    if not na(bestPrice)
        string zTxt = (bestPrice.zValue >= 0 ? "+" : "") + str.tostring(bestPrice.zValue, "#.##")
        result += "\n" + arrow + " " + bestPrice.metric + " Z: " + zTxt + " │ P: " + str.tostring(bestPrice.price, format.mintick)
        any := true

    if not na(bestVolume)
        string zTxt = (bestVolume.zValue >= 0 ? "+" : "") + str.tostring(bestVolume.zValue, "#.##")
        result += "\n" + arrow + " " + bestVolume.metric + " Z: " + zTxt + " │ P: " + str.tostring(bestVolume.price, format.mintick)
        any := true

    if not na(bestBuy)
        string zTxt = (bestBuy.zValue >= 0 ? "+" : "") + str.tostring(bestBuy.zValue, "#.##")
        result += "\n" + arrow + " " + bestBuy.metric + " Z: " + zTxt + " │ P: " + str.tostring(bestBuy.price, format.mintick)
        any := true

    if not na(bestSell)
        string zTxt = (bestSell.zValue >= 0 ? "+" : "") + str.tostring(bestSell.zValue, "#.##")
        result += "\n" + arrow + " " + bestSell.metric + " Z: " + zTxt + " │ P: " + str.tostring(bestSell.price, format.mintick)
        any := true

    if not na(bestDelta)
        string zTxt = (bestDelta.zValue >= 0 ? "+" : "") + str.tostring(bestDelta.zValue, "#.##")
        result += "\n" + arrow + " " + bestDelta.metric + " Z: " + zTxt + " │ P: " + str.tostring(bestDelta.price, format.mintick)
        any := true

    result

// Helper: Format dashboard line info
f_fmtLineInfo(ZLevel lvl) =>
    if na(lvl)
        "—"
    else
        "B" + str.tostring(lvl.barInGroup) + "-G" + str.tostring(lvl.groupNum) + " │ " + str.tostring(lvl.price, format.mintick)

// Option B (more informative): show nearest plus count of additional close/overlapping levels for the same metric.
f_fmtLineInfoPlus(array<ZLevel> levels, ZLevel nearest, string metricName, float tolerance) =>
    if na(nearest)
        "—"
    else
        int cnt = 0
        int size = array.size(levels)
        if size > 0
            for i = 0 to size - 1
                ZLevel lvl = array.get(levels, i)
                if lvl.metric == metricName and math.abs(lvl.price - nearest.price) <= tolerance
                    cnt += 1
        int extra = math.max(0, cnt - 1)
        string base = f_fmtLineInfo(nearest)
        extra > 0 ? base + " (+" + str.tostring(extra) + ")" : base

// ─────────────────────────────────────────────────────────────────────────────
// DASHBOARD (Label Mirror): show short summary in cell + full label text in tooltip
// ─────────────────────────────────────────────────────────────────────────────
f_isMetricEnabled(string m) =>
    (m == "Price"  and i_showZLines) or
     (m == "Volume" and i_showVolumeZLines) or
     (m == "Buy"    and i_showBuyZLines) or
     (m == "Sell"   and i_showSellZLines) or
     (m == "Delta"  and i_showDeltaZLines)

f_dashCellText(array<ZLevel> levels, ZLevel nearest, bool isUpper, float tol, bool enabled) =>
    if not enabled or na(nearest)
        "—"
    else
        // Clean cell output: only show nearest price (no "LEVEL", no item count)
        str.tostring(nearest.price, format.mintick)

f_dashCellTip(array<ZLevel> levels, ZLevel nearest, bool isUpper, float tol, bool enabled) =>
    if not enabled or na(nearest)
        ""
    else
        array<ZLevel> cluster = array.new<ZLevel>()
        int size = array.size(levels)
        if size > 0
            for i = 0 to size - 1
                ZLevel lvl = array.get(levels, i)
                if math.abs(lvl.price - nearest.price) <= tol and f_isMetricEnabled(lvl.metric)
                    array.push(cluster, lvl)
        array.size(cluster) == 0 ? "" :
             ("Nearest Z-Line details (Label Mirror)\n" +
              "Rule: one entry per metric; closest price to line level wins.\n\n" +
              f_buildCombinedLabel(cluster, isUpper, nearest.price))

// Only process within scope
if bar_index >= i_zPeriod - 1
    
    // --- Step 1: Remove levels older than totalWindow ---
    int oldestValidBar = bar_index - totalWindow
    
    if array.size(upperZLevels) > 0
        for i = array.size(upperZLevels) - 1 to 0
            if array.get(upperZLevels, i).barIdx < oldestValidBar
                array.remove(upperZLevels, i)
    
    if array.size(lowerZLevels) > 0
        for i = array.size(lowerZLevels) - 1 to 0
            if array.get(lowerZLevels, i).barIdx < oldestValidBar
                array.remove(lowerZLevels, i)
    
    // --- Step 2: Detect new levels for ALL metrics ---
    int detectBarIdx = bar_index - baseOff
    // Stamp group info relative to the detection bar itself (aligns CLOSED/LIVE behavior)
    [grpNum, barInGrp] = f_calcGroupInfo(detectBarIdx, bar_index, i_zPeriod)
    
    // Price
    if zPrice.raw >= i_upperZThreshold
        array.push(upperZLevels, ZLevel.new(high[baseOff], detectBarIdx, zPrice.raw, "Price", grpNum, barInGrp))
    if zPrice.raw <= i_lowerZThreshold
        array.push(lowerZLevels, ZLevel.new(low[baseOff], detectBarIdx, zPrice.raw, "Price", grpNum, barInGrp))
    
    // Volume
    if zVolume.raw >= i_upperZThreshold
        array.push(upperZLevels, ZLevel.new(high[baseOff], detectBarIdx, zVolume.raw, "Volume", grpNum, barInGrp))
    if zVolume.raw <= i_lowerZThreshold
        array.push(lowerZLevels, ZLevel.new(low[baseOff], detectBarIdx, zVolume.raw, "Volume", grpNum, barInGrp))
    
    // Buy
    if zBuy.raw >= i_upperZThreshold
        array.push(upperZLevels, ZLevel.new(high[baseOff], detectBarIdx, zBuy.raw, "Buy", grpNum, barInGrp))
    if zBuy.raw <= i_lowerZThreshold
        array.push(lowerZLevels, ZLevel.new(low[baseOff], detectBarIdx, zBuy.raw, "Buy", grpNum, barInGrp))
    
    // Sell
    if zSell.raw >= i_upperZThreshold
        array.push(upperZLevels, ZLevel.new(high[baseOff], detectBarIdx, zSell.raw, "Sell", grpNum, barInGrp))
    if zSell.raw <= i_lowerZThreshold
        array.push(lowerZLevels, ZLevel.new(low[baseOff], detectBarIdx, zSell.raw, "Sell", grpNum, barInGrp))
    
    // Delta
    if zDelta.raw >= i_upperZThreshold
        array.push(upperZLevels, ZLevel.new(high[baseOff], detectBarIdx, zDelta.raw, "Delta", grpNum, barInGrp))
    if zDelta.raw <= i_lowerZThreshold
        array.push(lowerZLevels, ZLevel.new(low[baseOff], detectBarIdx, zDelta.raw, "Delta", grpNum, barInGrp))
    
    // --- Step 3: Z-Lines persist (not removed on touch) ---
    // Lines remain visible until they expire from the group window
    
    // --- Step 4: Pick EARLIEST ACTIVE levels per metric (display-only; storage remains complete) ---
    nearestUpperPrice := (i_showUpperZLine and i_showZLines)       ? f_findEarliestByMetric(upperZLevels, "Price")  : na
    nearestLowerPrice := (i_showLowerZLine and i_showZLines)       ? f_findEarliestByMetric(lowerZLevels, "Price")  : na

    nearestUpperVol   := (i_showUpperZLine and i_showVolumeZLines) ? f_findEarliestByMetric(upperZLevels, "Volume") : na
    nearestLowerVol   := (i_showLowerZLine and i_showVolumeZLines) ? f_findEarliestByMetric(lowerZLevels, "Volume") : na

    nearestUpperBuy   := (i_showUpperZLine and i_showBuyZLines)    ? f_findEarliestByMetric(upperZLevels, "Buy")    : na
    nearestLowerBuy   := (i_showLowerZLine and i_showBuyZLines)    ? f_findEarliestByMetric(lowerZLevels, "Buy")    : na

    nearestUpperSell  := (i_showUpperZLine and i_showSellZLines)   ? f_findEarliestByMetric(upperZLevels, "Sell")   : na
    nearestLowerSell  := (i_showLowerZLine and i_showSellZLines)   ? f_findEarliestByMetric(lowerZLevels, "Sell")   : na

    nearestUpperDelta := (i_showUpperZLine and i_showDeltaZLines)  ? f_findEarliestByMetric(upperZLevels, "Delta")  : na
    nearestLowerDelta := (i_showLowerZLine and i_showDeltaZLines)  ? f_findEarliestByMetric(lowerZLevels, "Delta")  : na

    // Build dashboard-selected sets: ONLY what is actually drawn
    array.clear(dashUpperSel)
    array.clear(dashLowerSel)

    if not na(nearestUpperPrice)
        array.push(dashUpperSel, nearestUpperPrice)
    if not na(nearestUpperVol)
        array.push(dashUpperSel, nearestUpperVol)
    if not na(nearestUpperBuy)
        array.push(dashUpperSel, nearestUpperBuy)
    if not na(nearestUpperSell)
        array.push(dashUpperSel, nearestUpperSell)
    if not na(nearestUpperDelta)
        array.push(dashUpperSel, nearestUpperDelta)

    if not na(nearestLowerPrice)
        array.push(dashLowerSel, nearestLowerPrice)
    if not na(nearestLowerVol)
        array.push(dashLowerSel, nearestLowerVol)
    if not na(nearestLowerBuy)
        array.push(dashLowerSel, nearestLowerBuy)
    if not na(nearestLowerSell)
        array.push(dashLowerSel, nearestLowerSell)
    if not na(nearestLowerDelta)
        array.push(dashLowerSel, nearestLowerDelta)

    // --- Step 5: Cluster & draw UPPER lines (merge overlaps into one label/line) ---
    dashLabelOverlapWarn := ""

    float tolDraw   = syminfo.mintick * 2
    float gapPct    = i_labelMinGapPct * 0.01
    float maxOffAbs = globalAtr14 * i_labelMaxOffsetAtr

    // UPPER
    [uCP, uX1, uIds] = f_clusterAssign(dashUpperSel, tolDraw)
    int uClusters = array.size(uCP)

    // LOWER (pre-calculate for unified anti-overlap)
    [lCP_pre, lX1_pre, lIds_pre] = f_clusterAssign(dashLowerSel, tolDraw)
    int lClusters_pre = array.size(lCP_pre)

    // === UNIFIED ANTI-OVERLAP: Combine ALL label Y positions ===
    array<float> allBaseY = array.new<float>()
    array<bool>  allIsUpper = array.new<bool>()
    array<int>   allOrigIdx = array.new<int>()

    // Add upper clusters
    if uClusters > 0
        for ci = 0 to uClusters - 1
            array.push(allBaseY, array.get(uCP, ci))
            array.push(allIsUpper, true)
            array.push(allOrigIdx, ci)

    // Add lower clusters
    if lClusters_pre > 0
        for ci = 0 to lClusters_pre - 1
            array.push(allBaseY, array.get(lCP_pre, ci))
            array.push(allIsUpper, false)
            array.push(allOrigIdx, ci)

    // Sort all labels by Y position (ascending)
    int totalLabels = array.size(allBaseY)
    array<int> sortOrder = array.new<int>()
    if totalLabels > 0
        for i = 0 to totalLabels - 1
            array.push(sortOrder, i)
        if totalLabels > 1
            for i = 0 to totalLabels - 2
                for j = i + 1 to totalLabels - 1
                    int idxI = array.get(sortOrder, i)
                    int idxJ = array.get(sortOrder, j)
                    if array.get(allBaseY, idxJ) < array.get(allBaseY, idxI)
                        array.set(sortOrder, i, idxJ)
                        array.set(sortOrder, j, idxI)

    // Apply unified anti-overlap
    array<float> allDispY = array.new_float(totalLabels, na)
    float refAbs = math.max(syminfo.mintick, math.abs(refPrice))
    float gapAbs = refAbs * gapPct
    string unifiedWarn = ""
    int warnCnt = 0

    if totalLabels > 0
        float prevDispY = na
        for k = 0 to totalLabels - 1
            int idx = array.get(sortOrder, k)
            float baseY = array.get(allBaseY, idx)
            float dispY = baseY

            if k > 0 and not na(prevDispY)
                if dispY - prevDispY < gapAbs
                    dispY := prevDispY + gapAbs

            // Cap offset
            float off = dispY - baseY
            if maxOffAbs > 0 and math.abs(off) > maxOffAbs
                float cappedY = baseY + (off > 0 ? maxOffAbs : -maxOffAbs)
                if k > 0 and cappedY - prevDispY < gapAbs and warnCnt < 3
                    unifiedWarn := unifiedWarn + (unifiedWarn == "" ? "" : "\n") + "⚠ Cross-label overlap near " + str.tostring(baseY, format.mintick)
                    warnCnt += 1
                dispY := cappedY

            array.set(allDispY, idx, dispY)
            prevDispY := dispY

    if unifiedWarn != ""
        dashLabelOverlapWarn := unifiedWarn

    // Extract resolved Y positions back to upper/lower arrays
    array<float> uLblY = array.new_float(uClusters, na)
    array<float> lLblY_pre = array.new_float(lClusters_pre, na)

    if totalLabels > 0
        for i = 0 to totalLabels - 1
            bool isUp = array.get(allIsUpper, i)
            int origIdx = array.get(allOrigIdx, i)
            float resolvedY = array.get(allDispY, i)
            if isUp
                array.set(uLblY, origIdx, resolvedY)
            else
                array.set(lLblY_pre, origIdx, resolvedY)

    // Ensure pools match cluster count (create/update; delete extras)
    if uClusters > 0
        for ci = 0 to uClusters - 1
            float yBase = array.get(uCP, ci)
            float yLab  = array.get(uLblY, ci)
            yLab := na(yLab) ? yBase : yLab

            int x1  = array.get(uX1, ci)
            int x2  = bar_index
            int lblX = i_enableProjection ? (x2 + i_projectionLen) : (x2 + 2)
            int x2Main = i_enableProjection ? x2 : lblX

            array<ZLevel> members = array.new<ZLevel>()
            int sN = array.size(dashUpperSel)
            if sN > 0
                for k = 0 to sN - 1
                    if array.get(uIds, k) == ci
                        array.push(members, array.get(dashUpperSel, k))

            bool hasPos = false
            bool hasNeg = false
            int  mN     = array.size(members)
            if mN > 0
                for mi = 0 to mN - 1
                    float zv = array.get(members, mi).zValue
                    hasPos := hasPos or (zv >= 0)
                    hasNeg := hasNeg or (zv < 0)

            color lnClr =
                 hasPos and hasNeg ? COLOR_YELLOW :
                 hasPos            ? i_upperLineColor :
                 hasNeg            ? i_lowerLineColor :
                                     i_upperLineColor

            // Main line (solid)
            line ln = (array.size(upperLines) > ci) ? array.get(upperLines, ci) : na
            if na(ln)
                ln := line.new(x1, yBase, x2Main, yBase, color = lnClr, width = 2, style = line.style_solid)
                if array.size(upperLines) > ci
                    array.set(upperLines, ci, ln)
                else
                    array.push(upperLines, ln)
            else
                line.set_xy1(ln, x1, yBase)
                line.set_xy2(ln, x2Main, yBase)
                line.set_color(ln, lnClr)
                line.set_width(ln, 2)
                line.set_style(ln, line.style_solid)

            // Projection (dashed) — extend to label X so the jog has a clean base
            line pr = (array.size(upperProjLines) > ci) ? array.get(upperProjLines, ci) : na
            if i_enableProjection
                if na(pr)
                    pr := line.new(x2, yBase, lblX, yBase,
                         color = color.new(lnClr, 50), width = 1, style = line.style_dashed)
                    if array.size(upperProjLines) > ci
                        array.set(upperProjLines, ci, pr)
                    else
                        array.push(upperProjLines, pr)
                else
                    line.set_xy1(pr, x2, yBase)
                    line.set_xy2(pr, lblX, yBase)
                    line.set_color(pr, color.new(lnClr, 50))
                    line.set_width(pr, 1)
                    line.set_style(pr, line.style_dashed)
            else
                if not na(pr)
                    line.delete(pr)
                if array.size(upperProjLines) > ci
                    array.set(upperProjLines, ci, na)

            // Jog connector (vertical) to avoid “line through label center”
            line jg = (array.size(upperJogs) > ci) ? array.get(upperJogs, ci) : na
            if yLab != yBase
                if na(jg)
                    jg := line.new(lblX, yBase, lblX, yLab, color = color.new(lnClr, 35), width = 1, style = line.style_solid)
                    if array.size(upperJogs) > ci
                        array.set(upperJogs, ci, jg)
                    else
                        array.push(upperJogs, jg)
                else
                    line.set_xy1(jg, lblX, yBase)
                    line.set_xy2(jg, lblX, yLab)
                    line.set_color(jg, color.new(lnClr, 35))
                    line.set_width(jg, 1)
                    line.set_style(jg, line.style_solid)
            else
                if not na(jg)
                    line.delete(jg)
                if array.size(upperJogs) > ci
                    array.set(upperJogs, ci, na)

            // Label (combined) — keep true level in text; move label Y for anti-overlap
            string lblTxt = f_buildCombinedLabel(members, true, yBase)

            label lb = (array.size(upperLabels) > ci) ? array.get(upperLabels, ci) : na
            if na(lb)
                lb := label.new(lblX, yLab, lblTxt,
                     style = label.style_label_left, color = color.new(lnClr, 85),
                     textcolor = lnClr, size = f_getTextSize(i_textSizeStr))
                if array.size(upperLabels) > ci
                    array.set(upperLabels, ci, lb)
                else
                    array.push(upperLabels, lb)
            else
                label.set_xy(lb, lblX, yLab)
                label.set_text(lb, lblTxt)
                label.set_color(lb, color.new(lnClr, 85))
                label.set_textcolor(lb, lnClr)
                label.set_size(lb, f_getTextSize(i_textSizeStr))

    // Delete extra upper objects if clusters shrank
    if array.size(upperLines) > uClusters
        for di = array.size(upperLines) - 1 to uClusters
            line oldLn = array.get(upperLines, di)
            if not na(oldLn)
                line.delete(oldLn)
            array.remove(upperLines, di)

    if array.size(upperProjLines) > uClusters
        for di = array.size(upperProjLines) - 1 to uClusters
            line oldPr = array.get(upperProjLines, di)
            if not na(oldPr)
                line.delete(oldPr)
            array.remove(upperProjLines, di)

    if array.size(upperJogs) > uClusters
        for di = array.size(upperJogs) - 1 to uClusters
            line oldJg = array.get(upperJogs, di)
            if not na(oldJg)
                line.delete(oldJg)
            array.remove(upperJogs, di)

    if array.size(upperLabels) > uClusters
        for di = array.size(upperLabels) - 1 to uClusters
            label oldLb = array.get(upperLabels, di)
            if not na(oldLb)
                label.delete(oldLb)
            array.remove(upperLabels, di)

    // --- Step 6: Cluster & draw LOWER lines ---
    // Use pre-calculated clusters and unified anti-overlap results
    array<float> lCP = lCP_pre
    array<int> lX1 = lX1_pre
    array<int> lIds = lIds_pre
    int lClusters = lClusters_pre
    array<float> lLblY = lLblY_pre

    if lClusters > 0
        for ci = 0 to lClusters - 1
            float yBase = array.get(lCP, ci)
            float yLab  = array.get(lLblY, ci)
            yLab := na(yLab) ? yBase : yLab

            int x1  = array.get(lX1, ci)
            int x2  = bar_index
            int lblX = i_enableProjection ? (x2 + i_projectionLen) : (x2 + 2)
            int x2Main = i_enableProjection ? x2 : lblX

            array<ZLevel> members = array.new<ZLevel>()
            int sN = array.size(dashLowerSel)
            if sN > 0
                for k = 0 to sN - 1
                    if array.get(lIds, k) == ci
                        array.push(members, array.get(dashLowerSel, k))

            bool hasPos = false
            bool hasNeg = false
            int  mN     = array.size(members)
            if mN > 0
                for mi = 0 to mN - 1
                    float zv = array.get(members, mi).zValue
                    hasPos := hasPos or (zv >= 0)
                    hasNeg := hasNeg or (zv < 0)

            color lnClr =
                 hasPos and hasNeg ? COLOR_YELLOW :
                 hasPos            ? i_upperLineColor :
                 hasNeg            ? i_lowerLineColor :
                                     i_lowerLineColor

            // Main line (solid)
            line ln = (array.size(lowerLines) > ci) ? array.get(lowerLines, ci) : na
            if na(ln)
                ln := line.new(x1, yBase, x2Main, yBase, color = lnClr, width = 2, style = line.style_solid)
                if array.size(lowerLines) > ci
                    array.set(lowerLines, ci, ln)
                else
                    array.push(lowerLines, ln)
            else
                line.set_xy1(ln, x1, yBase)
                line.set_xy2(ln, x2Main, yBase)
                line.set_color(ln, lnClr)
                line.set_width(ln, 2)
                line.set_style(ln, line.style_solid)

            // Projection (dashed) — extend to label X so the jog has a clean base
            line pr = (array.size(lowerProjLines) > ci) ? array.get(lowerProjLines, ci) : na
            if i_enableProjection
                if na(pr)
                    pr := line.new(x2, yBase, lblX, yBase,
                         color = color.new(lnClr, 50), width = 1, style = line.style_dashed)
                    if array.size(lowerProjLines) > ci
                        array.set(lowerProjLines, ci, pr)
                    else
                        array.push(lowerProjLines, pr)
                else
                    line.set_xy1(pr, x2, yBase)
                    line.set_xy2(pr, lblX, yBase)
                    line.set_color(pr, color.new(lnClr, 50))
                    line.set_width(pr, 1)
                    line.set_style(pr, line.style_dashed)
            else
                if not na(pr)
                    line.delete(pr)
                if array.size(lowerProjLines) > ci
                    array.set(lowerProjLines, ci, na)

            // Jog connector (vertical)
            line jg = (array.size(lowerJogs) > ci) ? array.get(lowerJogs, ci) : na
            if yLab != yBase
                if na(jg)
                    jg := line.new(lblX, yBase, lblX, yLab, color = color.new(lnClr, 35), width = 1, style = line.style_solid)
                    if array.size(lowerJogs) > ci
                        array.set(lowerJogs, ci, jg)
                    else
                        array.push(lowerJogs, jg)
                else
                    line.set_xy1(jg, lblX, yBase)
                    line.set_xy2(jg, lblX, yLab)
                    line.set_color(jg, color.new(lnClr, 35))
                    line.set_width(jg, 1)
                    line.set_style(jg, line.style_solid)
            else
                if not na(jg)
                    line.delete(jg)
                if array.size(lowerJogs) > ci
                    array.set(lowerJogs, ci, na)

            // Label — keep true level in text; move label Y for anti-overlap
            string lblTxt = f_buildCombinedLabel(members, false, yBase)

            label lb = (array.size(lowerLabels) > ci) ? array.get(lowerLabels, ci) : na
            if na(lb)
                lb := label.new(lblX, yLab, lblTxt,
                     style = label.style_label_left, color = color.new(lnClr, 85),
                     textcolor = lnClr, size = f_getTextSize(i_textSizeStr))
                if array.size(lowerLabels) > ci
                    array.set(lowerLabels, ci, lb)
                else
                    array.push(lowerLabels, lb)
            else
                label.set_xy(lb, lblX, yLab)
                label.set_text(lb, lblTxt)
                label.set_color(lb, color.new(lnClr, 85))
                label.set_textcolor(lb, lnClr)
                label.set_size(lb, f_getTextSize(i_textSizeStr))

    // Delete extra lower objects if clusters shrank
    if array.size(lowerLines) > lClusters
        for di = array.size(lowerLines) - 1 to lClusters
            line oldLn = array.get(lowerLines, di)
            if not na(oldLn)
                line.delete(oldLn)
            array.remove(lowerLines, di)

    if array.size(lowerProjLines) > lClusters
        for di = array.size(lowerProjLines) - 1 to lClusters
            line oldPr = array.get(lowerProjLines, di)
            if not na(oldPr)
                line.delete(oldPr)
            array.remove(lowerProjLines, di)

    if array.size(lowerJogs) > lClusters
        for di = array.size(lowerJogs) - 1 to lClusters
            line oldJg = array.get(lowerJogs, di)
            if not na(oldJg)
                line.delete(oldJg)
            array.remove(lowerJogs, di)

    if array.size(lowerLabels) > lClusters
        for di = array.size(lowerLabels) - 1 to lClusters
            label oldLb = array.get(lowerLabels, di)
            if not na(oldLb)
                label.delete(oldLb)
            array.remove(lowerLabels, di)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// GROUP BOUNDARY LABELS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// Clear old group labels
if array.size(groupLabels) > 0
    for i = array.size(groupLabels) - 1 to 0
        label.delete(array.get(groupLabels, i))
