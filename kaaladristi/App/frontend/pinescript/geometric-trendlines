// Yang-Zhang volatility estimator.
// Combines overnight, close-to-open, and Rogers-Satchell components
// into a single sigma that normalizes the ICS coordinate space.
f_yangZhangSigma(int length) =>
    float yzOR = math.log(open / nz(close[1], open))
    float yzCO = math.log(close / open)
    float yzHO = math.log(high / open)
    float yzHC = math.log(high / close)
    float yzLO = math.log(low / open)
    float yzLC = math.log(low / close)
    float sqOR = ta.variance(yzOR, length, false)
    float sqCO = ta.variance(yzCO, length, false)
    float sqRS = ta.sma(yzHO * yzHC + yzLO * yzLC, length)
    float k  = 0.34 / (1.34 + (length + 1.0) / math.max(length - 1.0, 1.0))
    float sq = nz(sqOR) + k * nz(sqCO) + (1.0 - k) * nz(sqRS)
    math.max(math.sqrt(math.max(sq, 0.0)), MIN_SIGMA)

// Right-triangle in fully dimensionless ICS space.
// Vertical axis: y = log(price)/sigma (dimensionless).
// Horizontal axis: dx normalized by the lookback window,
// so x = bars/lookback is also dimensionless.
// theta and area are therefore scale-intrinsic.
// dy and theta are SIGNED (target above anchor => positive);
// area >= 0. In-place: writes directly into the passed TriangleData.
f_triangle(TriangleData td, float anchorPrice, int anchorBar,
           float targetPrice, int targetBar, float sig, int lookback) =>
    td.theta     := na
    td.dy        := na
    td.area      := na
    td.centroidY := na
    float dxBars = float(targetBar - anchorBar)
    float dx     = dxBars / math.max(float(lookback), 1.0)
    if math.abs(dx) > 0.0 and anchorPrice > 0.0 and targetPrice > 0.0 and sig > MIN_SIGMA
        float yA     = math.log(anchorPrice) / sig
        float yT     = math.log(targetPrice) / sig
        float _vd    = yT - yA
        td.theta     := math.atan(_vd / dx) * (180.0 / PI)
        td.area      := 0.5 * math.abs(_vd) * math.abs(dx)
        td.centroidY := (2.0 * yA + yT) / 3.0
        float _mag   = math.sqrt(dx * dx + _vd * _vd)
        td.dy        := _vd >= 0.0 ? _mag : -_mag

// Insertion sort — three parallel arrays, descending by keys.
// O(n²); n ≤ 50 in practice (angle map table rows).
f_sortParallelDesc(array<float> keys, array<float> dirs, array<int> durs) =>
    int n = keys.size()
    if n > 1
        for i = 1 to n - 1
            float kv = keys.get(i)
            float dv = dirs.get(i)
            int   uv = durs.get(i)
            int   j  = i - 1
            while j >= 0 and keys.get(j) < kv
                keys.set(j + 1, keys.get(j))
                dirs.set(j + 1, dirs.get(j))
                durs.set(j + 1, durs.get(j))
                j -= 1
            keys.set(j + 1, kv)
            dirs.set(j + 1, dv)
            durs.set(j + 1, uv)

// Insertion index for val in a descending-sorted float array.
f_insertPosDesc(array<float> sorted, float val) =>
    int pos = sorted.size()
    for i = 0 to sorted.size() - 1
        if val >= sorted.get(i)
            pos := i
            break
    pos

// Resets a TriangleData to na (prevents inactive periods from
// entering downstream pipelines as real zero values).
f_zeroTri(TriangleData td) =>
    td.theta     := na
    td.dy        := na
    td.area      := na
    td.centroidY := na

// Adaptive dual-model Gaussian KDE (parameter-free).
// pendMode false: features = θ at break, label = own direction.
// pendMode true : features = pending θ, label = NEXT break dir.
// Bandwidth   : Silverman's rule, d = 2 → h_i = σ̂_i · n^(−1/6).
// Probability : Beta(1,1) posterior scaled by Kish effective n.
// Significance: 95% credible interval vs 50% (normal approx).
// @returns [pUp 0-100, significant, effective sample size]
f_kdeProb(array<StructureBox> hist, float qC, float qF, bool pendMode) =>
    float _p  = 50.0
    bool  _sg = false
    float _ne = 0.0
    int _minN = pendMode ? 2 : 1
    if not na(qC) and not na(qF) and hist.size() >= _minN
        int _iEnd = hist.size() - _minN
        float _sumC = 0.0
        float _sumF = 0.0
        float _sqC  = 0.0
        float _sqF  = 0.0
        int   _nT   = 0
        for i = 0 to _iEnd
            StructureBox sb = hist.get(i)
            float fC = pendMode ? sb.thCeilPend : sb.thCeilAtBrk
            float fF = pendMode ? sb.thFlrPend  : sb.thFlrAtBrk
            if not na(fC) and not na(fF)
                _sumC += fC
                _sumF += fF
                _sqC  += fC * fC
                _sqF  += fF * fF
                _nT   += 1
        if _nT >= 2
            float _mC  = _sumC / _nT
            float _mF  = _sumF / _nT
            float _vC  = math.max((_sqC - _nT * _mC * _mC) / (_nT - 1.0), 0.0)
            float _vF  = math.max((_sqF - _nT * _mF * _mF) / (_nT - 1.0), 0.0)
            float _fac = math.pow(_nT, -1.0 / 6.0)
            float _hC  = math.max(_fac * math.sqrt(_vC), 1e-6)
            float _hF  = math.max(_fac * math.sqrt(_vF), 1e-6)
            float _wUp = 0.0
            float _wDn = 0.0
            float _w2  = 0.0
            for i = 0 to _iEnd
                StructureBox sb = hist.get(i)
                float fC = pendMode ? sb.thCeilPend : sb.thCeilAtBrk
                float fF = pendMode ? sb.thFlrPend  : sb.thFlrAtBrk
                float lb = pendMode ? hist.get(i + 1).breakDir : sb.breakDir
                if not na(fC) and not na(fF)
                    float zC = (qC - fC) / _hC
                    float zF = (qF - fF) / _hF
                    float w  = math.exp(-0.5 * (zC * zC + zF * zF))
                    _w2 += w * w
                    if lb > 0.0
                        _wUp += w
                    else
                        _wDn += w
            float _S = _wUp + _wDn
            if _S > 0.0 and _w2 > 0.0
                _ne := _S * _S / _w2
                float _aP = 1.0 + _wUp / _S * _ne
                float _bP = 1.0 + _wDn / _S * _ne
                float _mu = _aP / (_aP + _bP)
                _p := _mu * 100.0
                float _sd = math.sqrt(_aP * _bP / ((_aP + _bP) * (_aP + _bP) * (_aP + _bP + 1.0)))
                _sg := math.abs(_mu - 0.5) >= 1.645 * _sd
    [_p, _sg, _ne]

