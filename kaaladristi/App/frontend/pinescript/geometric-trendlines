// ══════════════
// Sigma
// ══════════════

max_bars_back(open,  500)
max_bars_back(high,  500)
max_bars_back(low,   500)
max_bars_back(close, 500)
max_bars_back(time,  502)

float sigma = f_yangZhangSigma(SIGMA_LEN)

// ══════════════
// Anchor Freeze / Reset + Structure Tracking
// ══════════════

// HH/LL over the lookback window, excluding the current bar.
float _triHH = ta.highest(high[1], i_lookback)
float _triLL = ta.lowest(low[1],   i_lookback)

// Pending anchors preview — window includes the current bar,
// so these equal exactly what the next bar's freeze will lock.
float _pvHH = ta.highest(high, i_lookback)
float _pvLL = ta.lowest(low,   i_lookback)

int  minCalcBars = math.max(SIGMA_LEN, i_lookback)
bool hasData     = bar_index >= minCalcBars

var FrozenAnchors fa = FrozenAnchors.new()
var array<StructureBox> boxHistory  = array.new<StructureBox>()
var array<box>          _drawnBoxes = array.new<box>()

// Structure-level accumulators (persist via var).
var int   stDur       = 0
var float stMaxHi     = na
var float stMinLo     = na
var float stThCeilMax = na
var float stThFlrMin  = na

// — Estimate log state —
var float pPendHeld   = na
var bool  sigPendHeld = false
var float nePendHeld   = na
var float pBirthHeld   = na
var bool  sigBirthHeld = false
var int   cntPend     = 0
var int   okPend      = 0
var int   cntBirth    = 0
var int   okBirth     = 0

// — Online calibration state —
// 20 cells = 10 confidence bins (5-pt) × 2 stability states.
// Granularity validated 2026-07-03 on 14 datasets / 543,070 bars:
// design C, walk-forward ECE 3.37 pp vs 3.56 pp baseline,
// coverage 97.6%, second-half transfer 3.40 pp.
// Stability dimension re-validated 2026-07-06 with JUMP_WIN 3 /
// CAL_JUMPTH 1.5: paired prequential ECE 1.82 vs 1.87 pp across
// all 14 datasets — passes the ECE <= baseline + 0.5 pp rule.
// calHitW / calTotW : fading counters, per-cell λ decay.
// probRing : last JUMP_WIN per-bar P values of the active structure.
// cellBuf  : per-bar (cell, side) log, graded at the break.
var array<float> calHitW   = array.new<float>(20, 0.0)
var array<float> calTotW   = array.new<float>(20, 0.0)
var array<float> probRing  = array.new<float>()
var array<int>   cellBuf   = array.new<int>()

// — Verified track record state —
// callBuf   : side of each confirmed full call (state 6) inside
//             the active structure — 1 up, 0 down. Graded at break.
// trackRing : rolling 1/0 results of graded calls, FIFO capped at
//             TRACK_CAP. trackOk mirrors its running hit sum.
var array<int>   callBuf   = array.new<int>()
var array<int>   trackRing = array.new<int>()
var int          trackOk   = 0

// Per-bar CSV log columns (na except on event bars).
float lgEvent = na
float lgThCB  = na
float lgThFB  = na
float lgPB    = na
float lgSigB  = na
float lgNeB   = na
float lgPP    = na
float lgSigP  = na
float lgNeP   = na
float lgHitP  = na
float lgHitB  = na
float lgAccP  = na
float lgAccB  = na
float lgThCP  = na
float lgThFP  = na
float lgPBar  = na
float lgJmpB  = na
float lgCellB = na
float lgStateB = na
float lgCalBar = na
float lgAccC   = na
float lgCntC   = na

// Freeze when inactive and enough data exists.
// Birth bookkeeping: reset accumulators for the new structure.
if not fa.is_active and hasData and _triHH > 0.0 and _triLL > 0.0
    fa.hh        := _triHH
    fa.ll        := _triLL
    fa.bar_x     := bar_index - i_lookback + 1
    fa.time_x    := time[i_lookback - 1]
    fa.is_active := true
    stDur        := 0
    stMaxHi      := na
    stMinLo      := na
    stThCeilMax  := na
    stThFlrMin   := na
    probRing.clear()
    cellBuf.clear()
    callBuf.clear()

// ══════════════
// Triangle Calc + Per-bar Tracking (runs before reset)
// ══════════════

var TriangleData tri1 = TriangleData.new()
var TriangleData tri3 = TriangleData.new()

// Scratch triangle for pending-anchor angle measurements.
var TriangleData triPd = TriangleData.new()

if fa.is_active
    f_triangle(tri1, fa.hh, fa.bar_x, high, bar_index, sigma, i_lookback)
    f_triangle(tri3, fa.ll, fa.bar_x, low,  bar_index, sigma, i_lookback)
    stDur += 1
    if stDur == 1
        // Birth (freeze) event — log angles and birth forecast.
        [_bp, _bs, _bn] = f_kdeProb(boxHistory, tri1.theta, tri3.theta, false)
        pBirthHeld   := _bp
        sigBirthHeld := _bs
        lgEvent    := 1
        lgThCB     := tri1.theta
        lgThFB     := tri3.theta
        lgPB       := _bp
        lgSigB     := _bs ? 1.0 : 0.0
        lgNeB      := _bn
    if na(stMaxHi) or high >= stMaxHi
        stMaxHi     := high
        stThCeilMax := tri1.theta
    if na(stMinLo) or low <= stMinLo
        stMinLo     := low
        stThFlrMin  := tri3.theta
    // — Per-bar probability, jumpiness ring, cell log —
    // Exact replication of the validated pipeline:
    // population stdev (denominator = JUMP_WIN) over a
    // JUMP_WIN-bar window of P; only significant bars
    // with a full ring are logged for calibration.
    if barstate.isconfirmed
        [_cp, _cs, _cn] = f_kdeProb(boxHistory, tri1.theta, tri3.theta, false)
        lgPBar   := _cp
        probRing.push(_cp)
        if probRing.size() > JUMP_WIN
            probRing.shift()
        // Jumpiness on every full ring — the state ladder needs it
        // even on non-significant bars. LEARNING is unchanged: cells
        // are logged only on significant bars with a full ring, the
        // exact validated prequential pipeline.
        bool  _ringFull = probRing.size() == JUMP_WIN
        float _jstd     = na
        if _ringFull
            float _jm = 0.0
            for i = 0 to JUMP_WIN - 1
                _jm += probRing.get(i)
            _jm /= float(JUMP_WIN)
            float _jv = 0.0
            for i = 0 to JUMP_WIN - 1
                float _dv = probRing.get(i) - _jm
                _jv += _dv * _dv
            _jstd  := math.sqrt(_jv / float(JUMP_WIN))
            lgJmpB := _jstd
        if _cs and _ringFull
            float _cc   = math.max(_cp, 100.0 - _cp)
            int   _bin  = math.min(int((_cc - 50.0) / 5.0), 9)
            int   _cell = _bin * 2 + (_jstd < CAL_JUMPTH ? 0 : 1)
            lgCellB := float(_cell)
            cellBuf.push(_cell * 2 + (_cp > 50.0 ? 1 : 0))
        // — Unified per-bar state (Engine v2 decision ladder) —
        // 1 newborn (ring not full) · 2 unstable · 3 too close ·
        // 4 cold class · 5 class record neutral (Wald fails) ·
        // 6 full call. Wald (1943) large-sample test applied to the
        // prequential fading-factor rate (Gama et al., 2013), so the
        // significance gate sits on the number the user actually
        // sees. Confirmed bars only — repaint-free by construction.
        if not _ringFull
            lgStateB := 1.0
        else if _jstd >= CAL_JUMPTH
            lgStateB := 2.0
        else if not _cs
            lgStateB := 3.0
        else
            float _cc2   = math.max(_cp, 100.0 - _cp)
            int   _bin2  = math.min(int((_cc2 - 50.0) / 5.0), 9)
            int   _cell2 = _bin2 * 2
            float _tw    = calTotW.get(_cell2)
            if _tw < CAL_MINW
                lgStateB := 4.0
            else
                float _r    = calHitW.get(_cell2) / _tw
                bool  _wald = math.abs(_r - 0.5) >= 1.645 * math.sqrt(math.max(_r * (1.0 - _r), 1e-9) / _tw)
                lgCalBar := 100.0 * _r
                lgStateB := _wald ? 6.0 : 5.0
                if _wald
                    callBuf.push(_cp > 50.0 ? 1 : 0)
else
    f_zeroTri(tri1)
    f_zeroTri(tri3)
    // Pending-phase per-bar probability — same engine the estimate
    // label uses (pendMode = true), sampled on confirmed bars so the
    // alert series stays repaint-free. Ring holds pending-only values
    // (cleared at break) to keep jumpiness phase-pure. No cell logging:
    // calibration cells are trained on active-mode samples only.
    // Alerts only need recent history — deep-history pending KDE is
    // skipped to stay inside TradingView's computation budget. This
    // block feeds no learning or calibration state, so skipping old
    // bars changes nothing in the model.
    if hasData and barstate.isconfirmed and last_bar_index - bar_index <= 5000
        f_triangle(triPd, _pvHH, bar_index - i_lookback + 2, high, bar_index, sigma, i_lookback)
        float _pdQC = triPd.theta
        f_triangle(triPd, _pvLL, bar_index - i_lookback + 2, low,  bar_index, sigma, i_lookback)
        float _pdQF = triPd.theta
        [_cp, _cs, _cn] = f_kdeProb(boxHistory, _pdQC, _pdQF, true)
        lgPBar   := _cp
        probRing.push(_cp)
        if probRing.size() > JUMP_WIN
            probRing.shift()
        if _cs and probRing.size() == JUMP_WIN
            float _jm = 0.0
            for i = 0 to JUMP_WIN - 1
                _jm += probRing.get(i)
            _jm /= float(JUMP_WIN)
            float _jv = 0.0
            for i = 0 to JUMP_WIN - 1
                float _dv = probRing.get(i) - _jm
                _jv += _dv * _dv
            lgJmpB := math.sqrt(_jv / float(JUMP_WIN))

// ══════════════
// Break Detection — snapshot then deactivate
// ══════════════

float brDur       = na
float brHH        = na
float brLL        = na
float brMaxHi     = na
float brMinLo     = na
float brThCeilMax = na
float brThFlrMin  = na
float brDir       = na

if fa.is_active and hasData
    if close > fa.hh or close < fa.ll
        brDur        := float(stDur)
        brHH         := fa.hh
        brLL         := fa.ll
        brMaxHi      := stMaxHi
        brMinLo      := stMinLo
        brThCeilMax  := stThCeilMax
        brThFlrMin   := stThFlrMin
        brDir        := close > fa.hh ? 1.0 : -1.0
        // Pending θ at this break — measured against the preview
        // anchors. Training feature for predicting the direction
        // of the NEXT structure's break while in pending mode.
        f_triangle(triPd, _pvHH, bar_index - i_lookback + 2, high, bar_index, sigma, i_lookback)
        float _pdC = triPd.theta
        f_triangle(triPd, _pvLL, bar_index - i_lookback + 2, low,  bar_index, sigma, i_lookback)
        float _pdF = triPd.theta
        boxHistory.push(StructureBox.new(
             hh          = fa.hh,
             ll          = fa.ll,
             startTime   = fa.time_x,
             endTime     = time,
             startBar    = fa.bar_x,
             endBar      = bar_index,
             breakDir    = brDir,
             duration    = stDur,
             maxHi       = stMaxHi,
             minLo       = stMinLo,
             thCeilAtMax = stThCeilMax,
             thFlrAtMin  = stThFlrMin,
             thCeilAtBrk = tri1.theta,
             thFlrAtBrk  = tri3.theta,
             thCeilPend  = _pdC,
             thFlrPend   = _pdF))
        while boxHistory.size() > 500
            boxHistory.shift()
        // — P31 · grade cell buffer, update fading counters —
        // Leak-free: learning happens only after the outcome is
        // known. λ decay is applied per cell, only on that cell's
        // own samples, in chronological order — the exact
        // prequential fading-factor estimator that was validated
        // (mean ECE 20.0 → 3.5 pp across 14 datasets).
        if cellBuf.size() > 0
            for i = 0 to cellBuf.size() - 1
                int  _enc = cellBuf.get(i)
                int  _cl  = _enc / 2
                bool _sUp = _enc % 2 == 1
                float _h  = _sUp == (brDir > 0.0) ? 1.0 : 0.0
                calHitW.set(_cl, calHitW.get(_cl) * CAL_LAMBDA + _h)
                calTotW.set(_cl, calTotW.get(_cl) * CAL_LAMBDA + 1.0)
            cellBuf.clear()
        // — Grade call buffer for verified track record —
        if callBuf.size() > 0
            for i = 0 to callBuf.size() - 1
                int _side = callBuf.get(i)
                int _hit  = (_side == 1) == (brDir > 0.0) ? 1 : 0
                trackRing.push(_hit)
                trackOk += _hit
                if trackRing.size() > TRACK_CAP
                    trackOk -= trackRing.shift()
            callBuf.clear()
        lgAccC := trackRing.size() > 0 ? 100.0 * trackOk / trackRing.size() : na
        lgCntC := float(trackRing.size())
        // — Estimate log: score held estimates, emit CSV row —
        lgEvent := na(lgEvent) ? 2.0 : 3.0
        if not na(pPendHeld)
            lgHitP  := (pPendHeld > 50.0) == (brDir > 0.0) ? 1.0 : 0.0
            cntPend += 1
            okPend  += int(lgHitP)
            lgPP    := pPendHeld
            lgSigP  := sigPendHeld ? 1.0 : 0.0
            lgNeP   := nePendHeld
        if not na(pBirthHeld)
            lgHitB   := (pBirthHeld > 50.0) == (brDir > 0.0) ? 1.0 : 0.0
            cntBirth += 1
            okBirth  += int(lgHitB)
        lgAccP := cntPend  > 0 ? 100.0 * okPend  / cntPend  : na
        lgAccB := cntBirth > 0 ? 100.0 * okBirth / cntBirth : na
        lgThCP := _pdC
        lgThFP := _pdF
        // Estimate for the NEXT structure, made at this break.
        [_np, _ns, _nn] = f_kdeProb(boxHistory, _pdC, _pdF, true)
        pPendHeld    := _np
        sigPendHeld  := _ns
        nePendHeld   := _nn
        pBirthHeld   := na
        sigBirthHeld := false
        probRing.clear()
        fa.is_active := false

// ══════════════
// Data Window / CSV Outputs
// ══════════════

plot(tri1.theta, "Ceiling θ",        display = display.data_window)
plot(tri3.theta, "Floor θ",          display = display.data_window)
plot(brDur,       "Str Duration",     display = display.data_window)
plot(brHH,        "Str Frozen HH",    display = display.data_window)
plot(brLL,        "Str Frozen LL",    display = display.data_window)
plot(brMaxHi,     "Str Max High",     display = display.data_window)
plot(brMinLo,     "Str Min Low",      display = display.data_window)
plot(brThCeilMax, "Str θ Ceil @Max",  display = display.data_window)
plot(brThFlrMin,  "Str θ Floor @Min", display = display.data_window)
plot(brDir,       "Str Break Dir",    display = display.data_window)

