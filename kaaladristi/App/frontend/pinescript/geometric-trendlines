// ══════════════
// Chart Overlay — Anchor Lines + Geometric Trend Lines
// ══════════════

const color CLR_CEIL = #ef5350
const color CLR_FLR  = #26a69a

var line  _aHhLn      = na
var line  _aLlLn      = na
var line  _aVtLn      = na
var label _aHhLbl     = na
var label _aLlLbl     = na
var line  _trendCeil  = na
var line  _trendFlr   = na
var label _angCeilLbl = na
var label _angFlrLbl  = na
var table _tblAngMap  = na
var label _predLbl    = na
var line  _predLn     = na

if barstate.islast

    line.delete(_aHhLn)
    line.delete(_aLlLn)
    line.delete(_aVtLn)
    label.delete(_aHhLbl)
    label.delete(_aLlLbl)
    line.delete(_trendCeil)
    line.delete(_trendFlr)
    label.delete(_angCeilLbl)
    label.delete(_angFlrLbl)
    label.delete(_predLbl)
    line.delete(_predLn)

    // — Structure Boxes —
    while _drawnBoxes.size() > 0
        box.delete(_drawnBoxes.pop())
    if i_showBoxes
        int    _bw    = i_boxStyle == "None" ? 0 : i_boxBorder
        string _bs    = switch i_boxStyle
            "Dashed" => line.style_dashed
            "Dotted" => line.style_dotted
            =>          line.style_solid
        color  _upBg  = color.new(i_boxUpClr,  i_boxBgAlpha)
        color  _dnBg  = color.new(i_boxDnClr,  i_boxBgAlpha)
        color  _actBg = color.new(i_boxActClr, i_boxBgAlpha)
        int _drawN    = math.min(i_histBoxes, boxHistory.size())
        int _drawOfs  = boxHistory.size() - _drawN
        for i = _drawOfs to boxHistory.size() - 1
            StructureBox sb = boxHistory.get(i)
            bool _isUp = sb.breakDir > 0.0
            _drawnBoxes.push(box.new(
                 sb.startTime, sb.hh, sb.endTime, sb.ll,
                 xloc         = xloc.bar_time,
                 border_color = _isUp ? i_boxUpClr : i_boxDnClr,
                 border_width = _bw,
                 border_style = _bs,
                 bgcolor      = _isUp ? _upBg : _dnBg))
        if fa.is_active
            _drawnBoxes.push(box.new(
                 fa.time_x, fa.hh, time, fa.ll,
                 xloc         = xloc.bar_time,
                 border_color = i_boxActClr,
                 border_width = math.max(_bw, 1),
                 border_style = line.style_dashed,
                 bgcolor      = _actBg))

    // — Live query angles: active → structure θ · pending → preview θ —
    bool  _pendMode = not fa.is_active
    float _qC = tri1.theta
    float _qF = tri3.theta
    if _pendMode and hasData
        f_triangle(triPd, _pvHH, bar_index - i_lookback + 2, high, bar_index, sigma, i_lookback)
        _qC := triPd.theta
        f_triangle(triPd, _pvLL, bar_index - i_lookback + 2, low,  bar_index, sigma, i_lookback)
        _qF := triPd.theta

    // — KDE Probability (adaptive, parameter-free) —
    float _pUp     = 50.0
    float _pDn     = 50.0
    bool  _pSig    = false
    string _trdSym = "—"
    // Probability + significance via the shared adaptive engine.
    if not na(_qC) and not na(_qF) and boxHistory.size() > 0
        [_kp, _ks, _kn] = f_kdeProb(boxHistory, _qC, _qF, _pendMode)
        _pUp  := _kp
        _pDn  := 100.0 - _kp
        _pSig := _ks
        int _tN  = math.min(5, boxHistory.size())
        int _tUp = 0
        for i = boxHistory.size() - _tN to boxHistory.size() - 1
            if boxHistory.get(i).breakDir > 0.0
                _tUp += 1
        int _tDn = _tN - _tUp
        if _tUp >= 4
            _trdSym := "▲▲"
        else if _tUp == 3
            _trdSym := "▲"
        else if _tDn >= 4
            _trdSym := "▼▼"
        else if _tDn == 3
            _trdSym := "▼"

    // — Engine v2 · display-side unified state (decision ladder) —
    // Mirrors the confirmed-bar ladder. Live-bar jumpiness = last
    // JUMP_WIN - 1 confirmed P values + current live P, which
    // equals the logged value at bar close. States: 0 warm-up · 1 thin archive ·
    // 2 newborn · 3 unstable · 4 too close · 5 cold class ·
    // 6 class record neutral · 7 full call · 8 pending call.
    // The label always exists and every state shows its own real
    // diagnostics (operator rule, 2026-07-03). No raw fallback.
    int   _lblState = 0
    bool  _dirUp    = false
    float _numA     = na
    float _jShow    = na
    if not hasData
        _lblState := 0
        _numA     := float(minCalcBars - bar_index)
    else if boxHistory.size() < 2
        _lblState := 1
        _numA     := float(boxHistory.size())
    else if not _pendMode
        if probRing.size() < JUMP_WIN - 1
            _lblState := 2
            _dirUp    := pBirthHeld > 50.0
            _numA     := cntBirth > 0 ? 100.0 * okBirth / cntBirth : na
        else
            int _rN = probRing.size()
            float _jm = _pUp
            for i = _rN - (JUMP_WIN - 1) to _rN - 1
                _jm += probRing.get(i)
            _jm /= float(JUMP_WIN)
            float _jv = (_pUp - _jm) * (_pUp - _jm)
            for i = _rN - (JUMP_WIN - 1) to _rN - 1
                float _dv = probRing.get(i) - _jm
                _jv += _dv * _dv
            float _jstd = math.sqrt(_jv / float(JUMP_WIN))
            _jShow := _jstd
            if _jstd >= CAL_JUMPTH
                _lblState := 3
                _numA     := _jstd
            else if not _pSig
                _lblState := 4
            else
                float _dConf = math.max(_pUp, _pDn)
                int   _dBin  = math.min(int((_dConf - 50.0) / 5.0), 9)
                int   _dCell = _dBin * 2
                float _dTw   = calTotW.get(_dCell)
                _dirUp := _pUp > _pDn
                if _dTw < CAL_MINW
                    _lblState := 5
                    _numA     := _dTw
                else
                    float _dR    = calHitW.get(_dCell) / _dTw
                    bool  _dWald = math.abs(_dR - 0.5) >= 1.645 * math.sqrt(math.max(_dR * (1.0 - _dR), 1e-9) / _dTw)
                    _numA     := 100.0 * _dR
                    _lblState := _dWald ? 7 : 6
    else
        if probRing.size() >= JUMP_WIN - 1
            int _rN2 = probRing.size()
            float _jm2 = _pUp
            for i = _rN2 - (JUMP_WIN - 1) to _rN2 - 1
                _jm2 += probRing.get(i)
            _jm2 /= float(JUMP_WIN)
            float _jv2 = (_pUp - _jm2) * (_pUp - _jm2)
            for i = _rN2 - (JUMP_WIN - 1) to _rN2 - 1
                float _dv2 = probRing.get(i) - _jm2
                _jv2 += _dv2 * _dv2
            _jShow := math.sqrt(_jv2 / float(JUMP_WIN))
        if not na(_jShow) and _jShow >= CAL_JUMPTH
            _lblState := 3
            _numA     := _jShow
        else if na(pPendHeld) or not sigPendHeld
            _lblState := 4
        else
            _lblState := 8
            _dirUp    := pPendHeld > 50.0
            _numA     := cntPend > 0 ? 100.0 * okPend / cntPend : na

    // — Estimate Label · Engine v2 unified scenarios —
    // The label ALWAYS exists (operator rule): every state speaks
    // and every message carries its own real diagnostics. Single
    // headline number = the verified class rate; the raw claim is
    // never displayed. Percentages as integers, deviation with one
    // decimal. Scenario texts per GTL_Label_Scenarios_v2.
    if i_showPredLbl
        string _lt = ""
        color  _lc = #9598a1
        if _lblState == 0
            _lt := str.replace(f_txWarmup(), "{0}", str.tostring(_numA, "#"))
        else if _lblState == 1
            _lt := str.replace(f_txNoData(), "{0}", str.tostring(_numA, "#"))
        else if _lblState == 2
            if sigBirthHeld
                _lt := _dirUp ? f_txBirthUp() : f_txBirthDn()
                _lt += "\n" + (na(_numA) ? f_txNoStageRec() : str.replace(f_txStageRate(), "{0}", str.tostring(_numA, "#")))
                _lc := _dirUp ? i_boxUpClr : i_boxDnClr
            else
                _lt := f_txBirthUnclear()
            _lt += "\n" + f_txStabFrom5()
        else if _lblState == 3
            _lt := str.replace(f_txUnstable(), "{0}", str.tostring(_numA, "#.#"))
        else if _lblState == 4
            _lt := f_txIntro() + "\n" + f_txTooClose()
        else if _lblState == 5
            _lt := str.replace(_dirUp ? f_txColdUp() : f_txColdDn(), "{0}", str.tostring(_numA, "#"))
            _lc := _dirUp ? i_boxUpClr : i_boxDnClr
        else if _lblState == 6
            _lt := str.replace(f_txNeutralRec(), "{0}", str.tostring(_numA, "#"))
        else if _lblState == 7
            _lt := f_txIntro() + "\n" + str.replace(_dirUp ? f_txCallUp() : f_txCallDn(), "{0}", str.tostring(_numA, "#"))
            _lt += "\n" + str.replace(f_txSteadyJ(), "{0}", str.tostring(_jShow, "#.#"))
            _lc := _dirUp ? i_boxUpClr : i_boxDnClr
        else
            _lt := _dirUp ? f_txPendUp() : f_txPendDn()
            _lt += "\n" + (na(_numA) ? f_txNoStageRec() : str.replace(f_txPendStage(), "{0}", str.tostring(_numA, "#")))
            _lc := _dirUp ? i_boxUpClr : i_boxDnClr
        // Mobile compact mode — badge text uses the existing symbol
        // vocabulary only (up/down arrows, hourglass, warning, dash).
        // The untouched scenario sentence rides in the label tooltip,
        // shown on tap (mobile) or hover (desktop).
        string _ltFull = _lt
        if i_mobileMode
            string _sn = na(_numA) ? "—" : str.tostring(_numA, "#")
            _lt := switch _lblState
                0 => "⧗ " + _sn
                1 => "⧗ " + _sn
                2 => sigBirthHeld ? (_dirUp ? "▲" : "▼") : "—"
                3 => "⚠ " + str.tostring(_numA, "#.#")
                4 => "—"
                5 => (_dirUp ? "▲" : "▼") + " ⧗"
                6 => "—"
                7 => (_dirUp ? "▲ " : "▼ ") + _sn + "%"
                => "⧗ " + (_dirUp ? "▲" : "▼") + (na(_numA) ? "" : " " + _sn + "%")
        else
            _lt := f_wrap(_lt, 34)
        float _midY = _pendMode ? (_pvHH + _pvLL) / 2.0 : (fa.hh + fa.ll) / 2.0
        int _lx = bar_index + i_lblOffset
        _predLbl := label.new(_lx, _midY, _lt,
             xloc = xloc.bar_index,
             color = color.new(_lc, 82), textcolor = _lc,
             style = label.style_label_left,
             size = i_mobileMode ? i_lblSize + 5 : i_lblSize + 15,
             tooltip = i_mobileMode ? _ltFull : "")
        _predLn := line.new(bar_index, close, _lx, _midY,
             xloc = xloc.bar_index,
             color = color.new(_lc, 20), width = 2,
             style = line.style_dashed)


    // — Angle Map —
    if not na(_tblAngMap)
        table.delete(_tblAngMap)
        _tblAngMap := na
    if i_showAngMap and not i_mobileMode and boxHistory.size() > 0
        int _amN = math.min(i_histBoxes, boxHistory.size())
        if _amN > 0
            int _amOfs = boxHistory.size() - _amN
            array<float> _cK = array.new<float>()
            array<float> _cD = array.new<float>()
            array<int>   _cU = array.new<int>()
            array<float> _fK = array.new<float>()
            array<float> _fD = array.new<float>()
            array<int>   _fU = array.new<int>()
            for i = _amOfs to boxHistory.size() - 1
                StructureBox sb = boxHistory.get(i)
                _cK.push(sb.thCeilAtBrk)
                _cD.push(sb.breakDir)
                _cU.push(sb.duration)
                _fK.push(sb.thFlrAtBrk)
                _fD.push(sb.breakDir)
                _fU.push(sb.duration)
            f_sortParallelDesc(_cK, _cD, _cU)
            f_sortParallelDesc(_fK, _fD, _fU)
            bool  _hasNow = not na(_qC) and not na(_qF)
            int   _cPos   = _hasNow ? f_insertPosDesc(_cK, _qC) : -1
            int   _fPos   = _hasNow ? f_insertPosDesc(_fK, _qF) : -1
            int   _extra  = _hasNow ? 1 : 0
            // NOW color: significant → direction color;
            // neutral → amber (active) or gray (pending).
            color _nC     = _pendMode ? #9598a1 : #EF9F27
            color _nBg    = color.new(_nC, 85)
            if _pSig
                if _pUp > _pDn
                    _nC  := i_boxUpClr
                    _nBg := color.new(i_boxUpClr, 82)
                else
                    _nC  := i_boxDnClr
                    _nBg := color.new(i_boxDnClr, 82)
            color _tBg    = color.new(#1a1a1a, 20)
            string _pos   = switch i_tblPos
                "Top left"      => position.top_left
                "Top center"    => position.top_center
                "Middle left"   => position.middle_left
                "Middle center" => position.middle_center
                "Middle right"  => position.middle_right
                "Bottom left"   => position.bottom_left
                "Bottom center" => position.bottom_center
                "Bottom right"  => position.bottom_right
                =>                 position.top_right
            int _probRow = 0
            if _hasNow
                _probRow := 1
            int _trackRow = trackRing.size() > 0 ? 1 : 0
            int _rows = _amN + _extra + 1 + _probRow + _trackRow
            _tblAngMap := table.new(_pos,
                 columns = 6, rows = _rows,
                 bgcolor = _tBg,
                 frame_color  = color.new(color.gray, 60), frame_width  = 1,
                 border_color = color.new(color.gray, 80), border_width = 1)
            color _hcBg = color.new(#ef5350, 88)
            color _hfBg = color.new(#26a69a, 88)
            table.cell(_tblAngMap, f_col(0), 0, f_txDir(),   text_color = color.gray, text_size = i_lblSize, bgcolor = _hcBg, tooltip = f_ttDir())
            table.cell(_tblAngMap, f_col(1), 0, f_txCeil(),  text_color = #ef5350,    text_size = i_lblSize, bgcolor = _hcBg, tooltip = f_ttCeil())
            table.cell(_tblAngMap, f_col(2), 0, f_txDur(),   text_color = color.gray, text_size = i_lblSize, bgcolor = _hcBg, tooltip = f_ttDur())
            table.cell(_tblAngMap, f_col(3), 0, f_txDir(),   text_color = color.gray, text_size = i_lblSize, bgcolor = _hfBg, tooltip = f_ttDir())
            table.cell(_tblAngMap, f_col(4), 0, f_txFloor(), text_color = #26a69a,    text_size = i_lblSize, bgcolor = _hfBg, tooltip = f_ttFloor())
            table.cell(_tblAngMap, f_col(5), 0, f_txDur(),   text_color = color.gray, text_size = i_lblSize, bgcolor = _hfBg, tooltip = f_ttDur())
            int  _cdi = 0
            int  _fdi = 0
            bool _cd  = false
            bool _fd  = false
            int _lastData = _rows - 1 - _probRow - _trackRow
            string _nowSym = _pendMode ? "⧗" : RTL ? "←" : "→"
            for _r = 1 to _lastData
                if _hasNow and not _cd and _cdi == _cPos
                    table.cell(_tblAngMap, f_col(0), _r, _nowSym,                                text_color = _nC, text_size = i_lblSize, bgcolor = _nBg)
                    table.cell(_tblAngMap, f_col(1), _r, str.tostring(_qC, "#.#") + "°",         text_color = _nC, text_size = i_lblSize, bgcolor = _nBg)
                    table.cell(_tblAngMap, f_col(2), _r, _pendMode ? "0" : str.tostring(stDur),  text_color = _nC, text_size = i_lblSize, bgcolor = _nBg)
                    _cd := true
                else
                    bool _cu = _cD.get(_cdi) > 0.0
                    color _cc = _cu ? i_boxUpClr : i_boxDnClr
                    table.cell(_tblAngMap, f_col(0), _r, _cu ? "▲" : "▼",                        text_color = _cc,         text_size = i_lblSize)
                    table.cell(_tblAngMap, f_col(1), _r, str.tostring(_cK.get(_cdi), "#.#") + "°", text_color = color.white, text_size = i_lblSize)
                    table.cell(_tblAngMap, f_col(2), _r, str.tostring(_cU.get(_cdi)),               text_color = color.gray,  text_size = i_lblSize)
                    _cdi += 1
                if _hasNow and not _fd and _fdi == _fPos
                    table.cell(_tblAngMap, f_col(3), _r, _nowSym,                                text_color = _nC, text_size = i_lblSize, bgcolor = _nBg)
                    table.cell(_tblAngMap, f_col(4), _r, str.tostring(_qF, "#.#") + "°",         text_color = _nC, text_size = i_lblSize, bgcolor = _nBg)
                    table.cell(_tblAngMap, f_col(5), _r, _pendMode ? "0" : str.tostring(stDur),  text_color = _nC, text_size = i_lblSize, bgcolor = _nBg)
                    _fd := true
                else
                    bool _fu = _fD.get(_fdi) > 0.0
                    color _fc = _fu ? i_boxUpClr : i_boxDnClr
                    table.cell(_tblAngMap, f_col(3), _r, _fu ? "▲" : "▼",                        text_color = _fc,         text_size = i_lblSize)
                    table.cell(_tblAngMap, f_col(4), _r, str.tostring(_fK.get(_fdi), "#.#") + "°", text_color = color.white, text_size = i_lblSize)
                    table.cell(_tblAngMap, f_col(5), _r, str.tostring(_fU.get(_fdi)),               text_color = color.gray,  text_size = i_lblSize)
                    _fdi += 1
            if _probRow > 0
                int _pr = _rows - 1 - _trackRow
                color _puBg = color.new(i_boxUpClr, 90)
                color _pdBg = color.new(i_boxDnClr, 90)
                bool  _spk  = _lblState == 7
                color _puTx = _spk and _dirUp     ? i_boxUpClr : color.gray
                color _pdTx = _spk and not _dirUp ? i_boxDnClr : color.gray
                string _puTxt = "—"
                string _pdTxt = "—"
                if _spk
                    _puTxt := str.tostring(_dirUp ? _numA : 100.0 - _numA, "#") + "%"
                    _pdTxt := str.tostring(_dirUp ? 100.0 - _numA : _numA, "#") + "%"
                table.cell(_tblAngMap, f_col(0), _pr, f_txPUp(),                       text_color = _puTx, text_size = i_lblSize, bgcolor = _puBg, tooltip = f_ttPUp())
                table.cell(_tblAngMap, f_col(1), _pr, _puTxt,                          text_color = _puTx, text_size = i_lblSize, bgcolor = _puBg)
                table.cell(_tblAngMap, f_col(2), _pr, _pUp >= _pDn ? _trdSym : "",     text_color = _puTx, text_size = i_lblSize, bgcolor = _puBg)
                table.cell(_tblAngMap, f_col(3), _pr, f_txPDn(),                       text_color = _pdTx, text_size = i_lblSize, bgcolor = _pdBg, tooltip = f_ttPDn())
                table.cell(_tblAngMap, f_col(4), _pr, _pdTxt,                          text_color = _pdTx, text_size = i_lblSize, bgcolor = _pdBg)
                table.cell(_tblAngMap, f_col(5), _pr, _pDn > _pUp ? _trdSym : "",      text_color = _pdTx, text_size = i_lblSize, bgcolor = _pdBg)
            if _trackRow > 0
                int _tr  = _rows - 1
                int _tN  = trackRing.size()
                // BiDi fix: U+2066 (LRI) and U+2069 (PDI) isolate
                // left-to-right numbers inside right-to-left text,
                // preventing the table renderer from reordering digits.
                string _lri = RTL ? "⁦" : ""
                string _pdi = RTL ? "⁩" : ""
                string _t0 = _lri + str.tostring(trackOk) + _pdi
                string _t1 = _lri + str.tostring(_tN) + _pdi
                string _t2 = _lri + str.tostring(math.round(100.0 * trackOk / _tN), "#") + _pdi
                string _tTxt = str.replace(str.replace(str.replace(f_txTrackRec(), "{0}", _t0), "{1}", _t1), "{2}", _t2)
                // Ungraded calls of the active structure — appended
                // only while at least one call awaits its outcome.
                if callBuf.size() > 0
                    _tTxt += " · " + str.replace(f_txPendCalls(), "{0}", str.tostring(callBuf.size()))
                // Balanced two-line layout: every translation of
                // f_txTrackRec carries exactly one " · " at its
                // midpoint; str.replace swaps only the first
                // occurrence, so that midpoint becomes the break.
                _tTxt := str.replace(_tTxt, " · ", "\n")
                color  _trBg = color.new(#EF9F27, 88)
                table.cell(_tblAngMap, 0, _tr, _tTxt, text_color = #EF9F27, text_size = i_lblSize + 2, bgcolor = _trBg, tooltip = f_ttTrack(), text_formatting = text.format_bold)
                table.cell(_tblAngMap, 1, _tr, "", bgcolor = _trBg)
                table.cell(_tblAngMap, 2, _tr, "", bgcolor = _trBg)
                table.cell(_tblAngMap, 3, _tr, "", bgcolor = _trBg)
                table.cell(_tblAngMap, 4, _tr, "", bgcolor = _trBg)
                table.cell(_tblAngMap, 5, _tr, "", bgcolor = _trBg)
                table.merge_cells(_tblAngMap, 0, _tr, 5, _tr)


    if fa.is_active
        int _tfMs = timeframe.in_seconds() * 1000

        // Anchor lines (HH, LL, vertical freeze marker).
        if i_showAnchors
            _aHhLn  := line.new(fa.time_x, fa.hh, time, fa.hh,
                 xloc = xloc.bar_time,
                 color = CLR_CEIL, width = 1, style = line.style_dashed)
            _aLlLn  := line.new(fa.time_x, fa.ll, time, fa.ll,
                 xloc = xloc.bar_time,
                 color = CLR_FLR, width = 1, style = line.style_dashed)
            _aVtLn  := line.new(fa.time_x, fa.ll, fa.time_x, fa.hh,
                 xloc = xloc.bar_time,
                 color = color.new(color.gray, 40), width = 1,
                 style = line.style_dotted)
            _aHhLbl := label.new(time + 2 * _tfMs, fa.hh,
                 f_txHH() + " " + str.tostring(fa.hh, format.mintick),
                 xloc = xloc.bar_time,
                 color = color.new(CLR_CEIL, 80), textcolor = CLR_CEIL,
                 style = label.style_label_left, size = i_lblSize)
            _aLlLbl := label.new(time + 2 * _tfMs, fa.ll,
                 f_txLL() + " " + str.tostring(fa.ll, format.mintick),
                 xloc = xloc.bar_time,
                 color = color.new(CLR_FLR, 80), textcolor = CLR_FLR,
                 style = label.style_label_left, size = i_lblSize)

        // Geometric trend lines (triangle hypotenuse).
        // Each line runs from the frozen anchor to the current
        // bar's candle extreme (high for ceiling, low for floor).
        // When the two lines converge, they meet at the intersection
        // and stop — no crossing, no infinite extension.
        float _dx = float(bar_index - fa.bar_x)
        int   _endCeilT = time
        float _endCeilY = high
        int   _endFlrT  = time
        float _endFlrY  = low

        if _dx > 0.0
            float _slopeCeil = (high - fa.hh) / _dx
            float _slopeFlr  = (low  - fa.ll) / _dx
            float _slopeDiff = _slopeCeil - _slopeFlr
            if math.abs(_slopeDiff) > 1e-10
                float _dxCross = (fa.ll - fa.hh) / _slopeDiff
                if _dxCross > _dx
                    int   _tC = fa.time_x + int(math.round(_dxCross)) * _tfMs
                    float _yC = fa.hh + _slopeCeil * _dxCross
                    _endCeilT := _tC
                    _endCeilY := _yC
                    _endFlrT  := _tC
                    _endFlrY  := _yC

        _trendCeil := line.new(fa.time_x, fa.hh, _endCeilT, _endCeilY,
             xloc = xloc.bar_time, color = CLR_CEIL, width = 2)
        _trendFlr  := line.new(fa.time_x, fa.ll, _endFlrT, _endFlrY,
             xloc = xloc.bar_time, color = CLR_FLR, width = 2)

        // Angle labels on the vertical anchor.
        if not na(tri1.theta)
            _angCeilLbl := label.new(fa.time_x, fa.hh,
                 str.tostring(tri1.theta, "#.#") + "°",
                 xloc = xloc.bar_time,
                 color = color.new(CLR_CEIL, 80), textcolor = CLR_CEIL,
                 style = label.style_label_down, size = i_lblSize)
        if not na(tri3.theta)
            _angFlrLbl := label.new(fa.time_x, fa.ll,
                 str.tostring(tri3.theta, "#.#") + "°",
                 xloc = xloc.bar_time,
                 color = color.new(CLR_FLR, 80), textcolor = CLR_FLR,
                 style = label.style_label_up, size = i_lblSize)
    else if i_showAnchors and hasData
        int   _tfMsPv = timeframe.in_seconds() * 1000
        int   _pvT    = time[i_lookback - 2]
        color _pvLn   = color.new(color.gray, 30)
        color _pvBg   = color.new(color.gray, 85)
        color _pvTx   = color.new(color.gray, 10)
        _aHhLn  := line.new(_pvT, _pvHH, time, _pvHH,
             xloc = xloc.bar_time,
             color = _pvLn, width = 1, style = line.style_dotted)
        _aLlLn  := line.new(_pvT, _pvLL, time, _pvLL,
             xloc = xloc.bar_time,
             color = _pvLn, width = 1, style = line.style_dotted)
        _aVtLn  := line.new(_pvT, _pvLL, _pvT, _pvHH,
             xloc = xloc.bar_time,
             color = color.new(color.gray, 60), width = 1,
             style = line.style_dotted)
        _aHhLbl := label.new(time + 2 * _tfMsPv, _pvHH,
             f_txHHPend() + " " + str.tostring(_pvHH, format.mintick),
             xloc = xloc.bar_time,
             color = _pvBg, textcolor = _pvTx,
             style = label.style_label_left, size = i_lblSize)
        _aLlLbl := label.new(time + 2 * _tfMsPv, _pvLL,
             f_txLLPend() + " " + str.tostring(_pvLL, format.mintick),
             xloc = xloc.bar_time,
             color = _pvBg, textcolor = _pvTx,
             style = label.style_label_left, size = i_lblSize)

// ══════════════
// Alert Module
// ══════════════

// Alerts follow the unified engine state (Engine v2). The model
// "speaks" only when all four gates pass on the confirmed bar:
// sufficient evidence, stability (JUMP_WIN-bar jumpiness below
// CAL_JUMPTH), a warm class and
// the Wald test on the calibrated class rate (state 6). State 2
// marks an unstable estimate. All conditions read the confirmed
// per-bar log series, so alerts are repaint-free by construction.
// Transition pattern fires once when ENTERING a state.
// Recommended alert frequency: Once Per Bar Close.
// Custom probability thresholds: create the alert directly on the
// "Probability UP" or "Probability DOWN" plot with the built-in
// Crossing Up / Greater Than conditions — the threshold value is
// then set inside the alert dialog itself.

plot(100.0 - lgPBar, "Probability DOWN", display = display.data_window)

bool _isSpkUp  = nz(lgStateB) == 6.0 and nz(lgPBar, 50.0) > 50.0
bool _isSpkDn  = nz(lgStateB) == 6.0 and nz(lgPBar, 50.0) < 50.0
bool _isUnstab = nz(lgStateB) == 2.0

// — Signal trace markers (repaint-free) —
// Per-candle view of the confirmed-bar ladder: full call UP,
// full call DOWN, or evaluated-but-silent. Reads the same
// logged series the alerts use, so every marker appears on
// bar close only. Pending-phase bars carry no marker because
// the confirmed ladder is defined inside structures only.
bool _sigUndec = i_sigNc and not na(lgStateB) and lgStateB != 6.0
plotshape(i_sigUp and _isSpkUp, "Signal trace UP",
     style = shape.triangleup, location = location.belowbar,
     color = #00FF66, size = size.tiny)
plotshape(i_sigDn and _isSpkDn, "Signal trace DOWN",
     style = shape.triangleup, location = location.belowbar,
     color = #FF1744, size = size.tiny)
plotshape(_sigUndec, "Signal trace silent",
     style = shape.triangleup, location = location.belowbar,
     color = #B0BEC5, size = size.tiny)

bool _enterSpkUp  = _isSpkUp  and not _isSpkUp[1]
bool _enterSpkDn  = _isSpkDn  and not _isSpkDn[1]
bool _enterUnstab = _isUnstab and not _isUnstab[1]

alertcondition(_enterSpkUp,  "Model speaks UP",   '▲ The model speaks — calls of this class were right {{plot("Calibrated Rate")}}% of the time, direction UP. Price: {{close}}')
alertcondition(_enterSpkDn,  "Model speaks DOWN", '▼ The model speaks — calls of this class were right {{plot("Calibrated Rate")}}% of the time, direction DOWN. Price: {{close}}')
alertcondition(_enterUnstab, "Estimate unstable", '⚠ Estimate unstable — deviation {{plot("Log Jump Bar")}} is above the 1.5 threshold. The model holds direction until it settles. Price: {{close}}')