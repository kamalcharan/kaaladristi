// One triangle's measurements in ICS space.
// theta and dy are signed (+/-); area is always >= 0.
type TriangleData
    float theta     = 0.0
    float dy        = 0.0
    float area      = 0.0
    float centroidY = 0.0

// Archived structure — one completed ceiling/floor cycle.
// Stores geometry, timing, and break statistics for chart
// boxes and downstream pattern analysis.
type StructureBox
    float hh          = 0.0
    float ll          = 0.0
    int   startTime   = 0
    int   endTime     = 0
    int   startBar    = 0
    int   endBar      = 0
    float breakDir    = 0.0
    int   duration    = 0
    float maxHi       = 0.0
    float minLo       = 0.0
    float thCeilAtMax = 0.0
    float thFlrAtMin  = 0.0
    float thCeilAtBrk = 0.0
    float thFlrAtBrk  = 0.0
    float thCeilPend  = na
    float thFlrPend   = na

// The anchors frozen on the current structure, plus reset state.
// hh = highest high, ll = lowest low, mid = geometric mean sqrt(hh*ll).
type FrozenAnchors
    float hh        = 0.0
    float ll        = 0.0
    int   bar_x     = 0
    int   time_x    = 0
    bool  is_active = false

