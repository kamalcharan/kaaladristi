// Word-wrap for the scenario label texts. Breaks lines at spaces
// where the language has them; scripts without spaces (Chinese,
// Japanese) get a clean hard break at the width limit, which is
// typographically valid for CJK. Explicit newlines already in the
// text reset the line counter. Runs once per render on islast, so
// the O(n) character walk has negligible cost.
f_wrap(string src, int width) =>
    string out = ""
    int lineLen = 0
    int lastSp = -1
    int n = str.length(src)
    if n > 0
        for i = 0 to n - 1
            string ch = str.substring(src, i, i + 1)
            if ch == "\n"
                out := out + ch
                lineLen := 0
                lastSp := -1
            else
                out := out + ch
                lineLen += 1
                if ch == " "
                    lastSp := str.length(out) - 1
                if lineLen > width
                    if lastSp >= 0
                        out := str.substring(out, 0, lastSp) + "\n" + str.substring(out, lastSp + 1)
                        lineLen := str.length(out) - lastSp - 1
                        lastSp := -1
                    else
                        out := out + "\n"
                        lineLen := 0
    out

