# ── PostgREST (replaces Supabase) ──────────────────────────────────────────
# When running on the VPS behind nginx: /api/rest proxies to PostgREST
VITE_POSTGREST_URL=http://localhost:3000

# JWT secret shared with PostgREST for signing auth tokens
VITE_JWT_SECRET=

# Anon key — a pre-signed JWT with role=anon for public read access
# Generate: jwt.sign({ role: 'anon', iss: 'kaaladristi' }, JWT_SECRET)
VITE_ANON_KEY=

# Legacy Supabase keys (still supported by backend config.py fallback)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# VITE_SUPABASE_SERVICE_KEY=

GEMINI_API_KEY=

# ICICI Breeze API (for EOD data download)
BREEZE_API_KEY=
BREEZE_API_SECRET=
BREEZE_SESSION_TOKEN=
