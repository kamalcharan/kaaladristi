# ── Database (Self-hosted PostgreSQL) ──────────────────────────────────────
# Direct PG connection — used by Python backend scripts
DATABASE_URL=postgresql://kd_app:YOUR_PASSWORD@YOUR_VPS_IP:5432/kaala_dristi_db

# ── PostgREST (REST API layer — used by frontend) ────────────────────────
POSTGREST_URL=http://YOUR_VPS_IP:3000
POSTGREST_SERVICE_KEY=
VITE_POSTGREST_URL=http://YOUR_VPS_IP:3000
VITE_JWT_SECRET=
VITE_ANON_KEY=

GEMINI_API_KEY=

# ICICI Breeze API (for EOD data download)
BREEZE_API_KEY=
BREEZE_API_SECRET=
BREEZE_SESSION_TOKEN=
