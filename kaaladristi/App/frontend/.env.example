# ── Database (Self-hosted PostgreSQL) ──────────────────────────────────────
# Direct PG connection — used by Python backend only (not exposed to browser)
DB_PRIMARY=postgresql://vikuna_admin:YOUR_PASSWORD@YOUR_VPS_IP:5432/ki_prime_db
DB_PRIMARY_SSL=false

# JWT secret — must match "app.jwt_secret" set in PostgreSQL (see below)
JWT_SECRET=YOUR_JWT_SECRET_HERE
# Must equal the database's app.jwt_secret (ALTER DATABASE … SET) and PostgREST's
# PGRST_JWT_SECRET. Rotated 2026-09-26: a stale value here makes the pipeline API
# 401 every token PostgREST accepts (login → workspace → /login loop).
# Phase 1a API guards (backend only): off | audit | enforce. Default audit.
AUTH_MODE=audit
# Backend role. VPS: full (default). A dev machine whose only DB is production
# MUST set api-only — it serves every route from prod but runs no worker and no
# scheduler, so it cannot become a second pipeline.
PIPELINE2_ROLE=full
# CORS allow-list for kd-pipeline-api2 (comma-separated). Dev example:
# CORS_ORIGINS=https://dristiq.com,https://www.dristiq.com,http://localhost:5173
CORS_ORIGINS=https://dristiq.com,https://www.dristiq.com

# ── Theme ────────────────────────────────────────────────────────────────
# Product theme: kaaladristi (default dark) | tech-ai (cyan/teal) | jade-thorn (jade/brass)
VITE_THEME=kaaladristi

# ── PostgREST (REST API layer — used by frontend) ────────────────────────
# VITE_ prefix makes these available to the browser bundle at build time
VITE_POSTGREST_URL=http://YOUR_VPS_IP:3000
# Leave EMPTY on this deployment: production sends no key and logged-out calls
# run as the anon role. A stale key here is rejected outright (PGRST301) and
# breaks login. VITE_SUPABASE_ANON_KEY is no longer read — delete it if present.
VITE_ANON_KEY=

# ── Pipeline API ────────────────────────────────────────────────────────
# pipeline2_api.py — single backend for all pipeline + scanner endpoints
# VPS (Docker): leave empty — nginx proxy routes /api/ → kd-pipeline-api2
# Local dev: set to http://localhost:8101 if running backend directly
VITE_PIPELINE_API_URL=

# ── AI / LLM Configuration ───────────────────────────────────────────────────
# Vendor-agnostic. Uses direct HTTP — no SDK dependency.
# AI_PROVIDER: anthropic | openai  (openai also covers any OpenAI-compat endpoint)
# AI_BASE_URL: override base URL — e.g. https://llm.dristiq.com/v1 for Vikuna-LLM
# AI_MODEL:    any model ID the provider accepts — e.g. qwen3-4b or claude-haiku-4-5
# AI_API_KEY:  generic key var (ANTHROPIC_API_KEY also accepted for Anthropic)
# LLM_BASE_URL: second-priority OpenAI-compat fallback (e.g. local Qwen3 endpoint)
#               tried automatically when the primary provider returns None
# VANI_DB_URL: connection string for vani_db — interaction log target (separate from kaala_dristi_db)
VANI_DB_URL=postgresql://vikuna_admin:YOUR_PASSWORD@187.127.136.65:5432/vani_db

AI_ENABLED=false
AI_PROVIDER=openai
AI_BASE_URL=https://llm.dristiq.com/v1
AI_MODEL=qwen3-4b
AI_API_KEY=
LLM_BASE_URL=
# ANTHROPIC_API_KEY=   # legacy alias — AI_API_KEY takes precedence

GEMINI_API_KEY=
NODE_ENV=development
VANI_MOCK=true
PORT=3001

# ICICI Breeze API (for EOD data download)
BREEZE_API_KEY=
BREEZE_API_SECRET=
BREEZE_SESSION_TOKEN=

# ── Razorpay (payments) ──────────────────────────────────────────────────────
# Backend uses RAZORPAY_KEY_ID + RAZORPAY_KEY_SECRET (server-side, not VITE_)
# Frontend uses VITE_RAZORPAY_KEY_ID only (public key — safe to expose in browser)
# Use test keys during development. Charan provides live keys before production.
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
VITE_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID

# ── Analytics (PostHog Cloud — shared across all Vikuna products) ───────────
# One PostHog org/project shared by DristiQ, ContractNest, VaNi, etc. — every
# event auto-tags product:"dristiq" (see src/lib/analytics.ts) so it's safe to
# share the same project key across products. Leave VITE_POSTHOG_KEY empty to
# disable analytics entirely (local dev default — analytics.ts no-ops).
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ── VPS PostgREST setup reminder ─────────────────────────────────────────
# PostgREST must be started with:
#   PGRST_JWT_SECRET=<same as JWT_SECRET above>
#   PGRST_APP_SETTINGS_JWT_SECRET=<same as JWT_SECRET above>
#
# AND the DB must have:
#   ALTER DATABASE ki_prime_db SET "app.jwt_secret" = '<JWT_SECRET>';
# (only needs to be run once — persists across reconnects)

# Filing intelligence — the read (migration 229, lib/filing_reader.py).
# Needs ANTHROPIC_API_KEY (above; AI_API_KEY is accepted when it is an sk-ant key).
# Runs as the last step of every filings pull. Model: FILING_READ_MODEL, else
# CLAUDE_MODEL, else claude-haiku-4-5 (owner, 2026-09-28). Never AI_MODEL —
# that is the VaNi layer's and names the local Qwen on the VPS, which cannot
# read a PDF.
CLAUDE_MODEL=claude-haiku-4-5          # claude-sonnet-5 / claude-opus-5 for a stronger read
#FILING_READ_MODEL=                    # set only to give the reader a DIFFERENT model than CLAUDE_MODEL
FILING_READ_MAX_PER_PASS=300           # newest first; the backfill script drains the rest
# Which backend reads. anthropic (default) = the SDK, priced per row.
# local = the OpenAI-compatible server at FILING_READ_LOCAL_URL (else
# LLM_BASE_URL — the same llama.cpp Qwen3 the VaNi fallback uses), free,
# text only (scanned pages go through Tesseract, never a vision model).
# ⚠ FILING_READ_LOCAL_CTX must match the context the server was STARTED with
# (llama-server -c / --ctx-size). Documents average ~3,700 tokens, max ~15k;
# 4,096 holds fewer than half. Set the server to 16384 and say so here.
# The Qwen server is on the LLM VPS (72.60.222.136, llama.cpp behind Traefik,
# docs/llm/Vikuna-Infrastructure-Documentation-v3.pdf §3), NOT on the main VPS.
# With AI_PROVIDER=openai the reader INHERITS AI_BASE_URL (+/v1) and AI_API_KEY
# from the VaNi lines above, so only the backend switch and the context are
# needed; FILING_READ_LOCAL_URL / FILING_READ_LOCAL_KEY are overrides for a
# different server or key.
#FILING_READ_BACKEND=local
#FILING_READ_LOCAL_CTX=16384
#FILING_READ_LOCAL_URL=            # override only; default = AI_BASE_URL + /v1
#FILING_READ_LOCAL_KEY=            # override only; default = AI_API_KEY (when not an sk-ant key)
#FILING_READ_NEVER_TYPES=RECORD_DATE,ESOP,ALLOTMENT,AUTHORISED_CAPITAL,MGMT_CHANGE   # the default; override to widen/narrow
