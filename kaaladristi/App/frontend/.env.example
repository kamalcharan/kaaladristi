# ── Database (Self-hosted PostgreSQL) ──────────────────────────────────────
# Direct PG connection — used by Python backend only (not exposed to browser)
DB_PRIMARY=postgresql://vikuna_admin:YOUR_PASSWORD@YOUR_VPS_IP:5432/ki_prime_db
DB_PRIMARY_SSL=false

# JWT secret — must match "app.jwt_secret" set in PostgreSQL (see below)
JWT_SECRET=YOUR_JWT_SECRET_HERE

# ── Theme ────────────────────────────────────────────────────────────────
# Product theme: kaaladristi (default dark) | tech-ai (cyan/teal) | jade-thorn (jade/brass)
VITE_THEME=kaaladristi

# ── PostgREST (REST API layer — used by frontend) ────────────────────────
# VITE_ prefix makes these available to the browser bundle at build time
VITE_POSTGREST_URL=http://YOUR_VPS_IP:3000
VITE_ANON_KEY=

# ── Pipeline API ────────────────────────────────────────────────────────
# pipeline2_api.py — single backend for all pipeline + scanner endpoints
# VPS (Docker): leave empty — nginx proxy routes /api/ → kd-pipeline-api2
# Local dev: set to http://localhost:8101 if running backend directly
VITE_PIPELINE_API_URL=

# ── AI / LLM Configuration ───────────────────────────────────────────────────
# Vendor-agnostic. Uses direct HTTP — no SDK dependency.
# AI_PROVIDER: anthropic | openai  (openai also covers any OpenAI-compat endpoint)
# AI_BASE_URL: override base URL — e.g. https://llm.dristiq.io/v1 for Vikuna-LLM
# AI_MODEL:    any model ID the provider accepts — e.g. qwen3-4b or claude-haiku-4-5
# AI_API_KEY:  generic key var (ANTHROPIC_API_KEY also accepted for Anthropic)
# LLM_BASE_URL: second-priority OpenAI-compat fallback (e.g. local Qwen3 endpoint)
#               tried automatically when the primary provider returns None
# VANI_DB_URL: connection string for vani_db — interaction log target (separate from kaala_dristi_db)
VANI_DB_URL=postgresql://vikuna_admin:YOUR_PASSWORD@187.127.136.65:5432/vani_db

AI_ENABLED=false
AI_PROVIDER=openai
AI_BASE_URL=https://llm.dristiq.io/v1
AI_MODEL=qwen3-4b
AI_API_KEY=
LLM_BASE_URL=
# ANTHROPIC_API_KEY=   # legacy alias — AI_API_KEY takes precedence

GEMINI_API_KEY=
NODE_ENV=development
VANI_MOCK=true
PORT=3001

# ICICI Breeze API (for EOD data download)
BREEZE_API_KEY=
BREEZE_API_SECRET=
BREEZE_SESSION_TOKEN=

# ── VPS PostgREST setup reminder ─────────────────────────────────────────
# PostgREST must be started with:
#   PGRST_JWT_SECRET=<same as JWT_SECRET above>
#   PGRST_APP_SETTINGS_JWT_SECRET=<same as JWT_SECRET above>
#
# AND the DB must have:
#   ALTER DATABASE ki_prime_db SET "app.jwt_secret" = '<JWT_SECRET>';
# (only needs to be run once — persists across reconnects)
