# ── Database (Self-hosted PostgreSQL) ──────────────────────────────────────
# Direct PG connection — used by Python backend scripts
DATABASE_URL=postgresql://kd_app:YOUR_PASSWORD@YOUR_VPS_IP:5432/kaala_dristi_db

# ── PostgREST (REST API layer) ────────────────────────────────────────────
# Used by Python backend scripts directly
POSTGREST_URL=http://YOUR_VPS_IP:3000
POSTGREST_SERVICE_KEY=

# ── Frontend (VITE_ vars are baked into the JS bundle) ────────────────────
# Production: set to your public nginx URL (nginx proxies /db/ → postgrest)
# Example: VITE_POSTGREST_URL=http://YOUR_VPS_IP/db
#
# Local dev: LEAVE THIS UNSET — Vite proxies /db/ → POSTGREST_URL automatically.
# PostgREST must be running at POSTGREST_URL (default: http://localhost:3001).
# Run:  docker-compose -f docker-compose.yml up postgrest
# Then expose it:  docker run ... -p 3001:3000 ...  or add ports: "3001:3000" to postgrest service.
VITE_POSTGREST_URL=

VITE_PIPELINE_API_URL=http://localhost:8100
VITE_JWT_SECRET=
VITE_ANON_KEY=

GEMINI_API_KEY=

# ICICI Breeze API (for EOD data download)
BREEZE_API_KEY=
BREEZE_API_SECRET=
BREEZE_SESSION_TOKEN=
