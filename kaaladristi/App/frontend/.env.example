# ── Database (Self-hosted PostgreSQL) ──────────────────────────────────────
# Direct PG connection — used by Python backend scripts
DATABASE_URL=postgresql://kd_app:YOUR_PASSWORD@YOUR_VPS_IP:5432/kaala_dristi_db

# ── PostgREST (REST API layer) ────────────────────────────────────────────
# Used by Python backend scripts AND the Vite dev proxy.
# In production PostgREST is internal (no host port). For local dev it is
# exposed on 127.0.0.1:3001 via docker-compose.override.yml.
POSTGREST_URL=http://localhost:3001
POSTGREST_SERVICE_KEY=

# ── Frontend (VITE_ vars are baked into the JS bundle at build time) ──────
#
# Production (nginx build):
#   docker-compose sets VITE_POSTGREST_URL=http://YOUR_VPS_IP/db automatically.
#   You do NOT need to set it here for production.
#
# Local dev (npm run dev):
#   Leave VITE_POSTGREST_URL blank. Vite proxies /db/* → POSTGREST_URL above.
#   Start backend first: docker-compose up postgrest pipeline-api
VITE_POSTGREST_URL=

VITE_PIPELINE_API_URL=http://localhost:8100
VITE_JWT_SECRET=
VITE_ANON_KEY=

GEMINI_API_KEY=

# ICICI Breeze API (for EOD data download)
BREEZE_API_KEY=
BREEZE_API_SECRET=
BREEZE_SESSION_TOKEN=
