# DristiQ VPS environment — copy to .env and fill in values
# This file is safe to commit. .env is gitignored.

# PostgreSQL app user password (set on VPS)
KD_APP_PASSWORD=

# PostgREST anon JWT key (leave empty if PostgREST has no anon role auth)
VITE_ANON_KEY=

# Gemini API key (optional — only needed if Gemini features are used)
GEMINI_API_KEY=

# VPS public IP (used for reference only — not read at runtime)
VPS_IP=187.127.136.65

# ── LLM lanes (App/backend/lib/llm_lanes.py) ─────────────────────────────
# Which model serves which priority. Leave every LLM_ROUTE_* empty and all
# work stays on the local Qwen (the behaviour before lanes).
#   high   = filings disseminated in the last FILING_READ_HIGH_DAYS days (2)
#   medium = the older unread backlog
#   low    = history second-opinion checks
# A route is tried left to right; a provider answering 429 is skipped for
# LLM_<NAME>_COOLDOWN seconds. 'qwen' is the local server.
# Only PUBLIC text (filings, news) goes through a lane — free tiers may log it.
LLM_PROVIDERS=groq,openrouter
LLM_ROUTE_HIGH=groq,openrouter,qwen
LLM_ROUTE_MEDIUM=qwen
LLM_ROUTE_LOW=qwen
FILING_READ_HIGH_DAYS=2

LLM_GROQ_URL=https://api.groq.com/openai/v1
LLM_GROQ_KEY=
LLM_GROQ_MODEL=llama-3.3-70b-versatile
LLM_GROQ_CTX=8000          # the free tier caps tokens per MINUTE; a bigger document is refused
LLM_GROQ_COOLDOWN=120

LLM_OPENROUTER_URL=https://openrouter.ai/api/v1
LLM_OPENROUTER_KEY=
LLM_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
LLM_OPENROUTER_CTX=32000
LLM_OPENROUTER_COOLDOWN=300
